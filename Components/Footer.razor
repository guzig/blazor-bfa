@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FooterViewModel ViewModel

<footer class="lp-footer">
    <div class="lp-container lp-footer__inner">
        <!-- Brand -->
        <div class="lp-footer__brand">
            <a href="/" class="lp-nav__brand" style="color:#fff;">
                @ViewModel.CompanyName.Split(' ')[0]
                <span>@(ViewModel.CompanyName.Contains(' ') ? ViewModel.CompanyName[(ViewModel.CompanyName.IndexOf(' ') + 1)..] : "")</span>
            </a>
            <p>@ViewModel.CompanyDescription</p>
            @if (ViewModel.SocialLinks?.Any() == true)
            {
                <div style="display:flex; gap:.75rem; margin-top:1.25rem;">
                    @foreach (var social in ViewModel.SocialLinks)
                    {
                        <a href="@social.Href" target="_blank" style="width:36px; height:36px; border-radius:50%; background:rgba(255,255,255,.1); display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,.6); transition:background .15s;" class="lp-footer__social">
                            <RadzenIcon Icon="@social.Icon" Style="font-size:18px;" />
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Link groups -->
        @foreach (var group in ViewModel.LinkGroups)
        {
            <div class="lp-footer__links">
                <strong>@group.Title</strong>
                @foreach (var link in group.Links)
                {
                    <a href="@link.Href">@link.Text</a>
                }
            </div>
        }
    </div>

    <div class="lp-footer__bottom">
        <div class="lp-container">
            © @ViewModel.CurrentYear @ViewModel.CompanyName – Tutti i diritti riservati
        </div>
    </div>
</footer>

