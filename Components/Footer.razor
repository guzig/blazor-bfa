@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FooterViewModel ViewModel

<footer class="footer-new">
    <div class="footer-container-new">
        <div class="footer-main">
            @* Brand *@
            <div class="footer-brand">
                <div class="footer-logo-new">
                    <RadzenIcon Icon="bolt" Style="font-size:26px;" />
                    <span>@ViewModel.CompanyName</span>
                </div>
                <p style="color:rgba(255,255,255,0.55); font-size:0.9rem; line-height:1.7; margin-bottom:1.25rem; max-width:280px; font-family:'Plus Jakarta Sans',sans-serif;">
                    @ViewModel.CompanyDescription
                </p>
                <div class="footer-social">
                    @foreach (var social in ViewModel.SocialLinks)
                    {
                        <a href="@social.Href" target="_blank" class="social-icon" aria-label="@social.Icon">
                            <RadzenIcon Icon="@social.Icon" Style="font-size:16px;" />
                        </a>
                    }
                </div>
            </div>

            @* Link groups *@
            @foreach (var group in ViewModel.LinkGroups)
            {
                <div class="footer-links-column">
                    <p style="font-weight:600; color:rgba(255,255,255,0.9); font-size:0.9rem; margin-bottom:1.25rem; font-family:'Plus Jakarta Sans',sans-serif; letter-spacing:0.03em;">
                        @group.Title
                    </p>
                    <ul class="footer-links-list">
                        @foreach (var link in group.Links)
                        {
                            <li><a href="@link.Href" class="footer-link-new">@link.Text</a></li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="footer-bottom">
            <p style="color:rgba(255,255,255,0.4); font-size:0.825rem; font-family:'Plus Jakarta Sans',sans-serif;">
                © @ViewModel.CurrentYear @ViewModel.CompanyName. Tutti i diritti riservati.
            </p>
            <p style="color:rgba(255,255,255,0.4); font-size:0.825rem; font-family:'Plus Jakarta Sans',sans-serif;">
                Realizzato con <span style="color:#F87171;">❤</span> in Italia
            </p>
        </div>
    </div>
</footer>
