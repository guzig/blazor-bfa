@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject AboutViewModel ViewModel
@inject StatsViewModel StatsViewModel

<section id="about" class="about-section full-page-section">
    @* Sfondo: video a SX 40%, bianco a DX 60% *@
    <div class="about-bg-left">
        <video autoplay muted loop playsinline>
            <source src="videos/about-bg.mp4?v=1" type="video/mp4" />
        </video>
        <div class="about-bg-left-overlay"></div>
    </div>
    <div class="about-bg-right"></div>

    <div class="about-container">
        <div class="about-main-card">
            <div class="about-layout">
                <div class="about-content-col">
                    <RadzenText TextStyle="TextStyle.Subtitle1" Class="section-label" Style="color: var(--primary-color);">@ViewModel.SectionLabel</RadzenText>
                    <RadzenText TextStyle="TextStyle.H3" Class="about-title" Style="font-family:'Plus Jakarta Sans',sans-serif; font-weight:800; margin-bottom:1rem; color:var(--text-dark);">@ViewModel.Title</RadzenText>
                    <RadzenText Text="@ViewModel.Description" Class="about-description" />
                    <a href="@ViewModel.CtaHref" class="about-cta">
                        @ViewModel.CtaText
                        <span class="cta-arrow" aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>
        
        @* Stats Cards integrated in About section *@
        <div class="about-stats-container">
            <RadzenRow Gap="24px" JustifyContent="JustifyContent.Center">
                @foreach (var stat in StatsViewModel.StatCards)
                {
                    <RadzenColumn Size="6" SizeSm="6" SizeLg="3">
                        <div class="about-stat-card">
                            <div class="about-stat-icon" style="background: linear-gradient(135deg, @stat.GradientStart 0%, @stat.GradientEnd 100%);">
                                <RadzenIcon Icon="@stat.Icon" Style="font-size:24px; color:white;" />
                            </div>
                            <div class="about-stat-content">
                                <div class="about-stat-value">
                                    <span class="about-stat-number">@stat.Value</span>
                                    <span class="about-stat-suffix">@stat.Suffix</span>
                                </div>
                                <div class="about-stat-label">@stat.Label</div>
                            </div>
                        </div>
                    </RadzenColumn>
                }
            </RadzenRow>
        </div>
    </div>
    
    <ScrollIndicator TargetSection="services" Text="Scopri i Servizi" />
</section>

<style>
    /* ── Override sfondi globali: la sezione deve essere trasparente ── */
    section#about,
    .about-section,
    .about-section.full-page-section {
        background: transparent !important;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    /* ── SINISTRA: video (40% dello schermo, dall'alto in basso) ── */
    .about-bg-left {
        position: absolute !important;
        top: 0;
        left: 0;
        width: 40%;
        height: 100%;
        overflow: hidden;
        z-index: 0 !important;
    }

    .about-bg-left video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .about-bg-left-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.25);
        z-index: 1;
    }

    /* ── DESTRA: sfondo bianco (60% dello schermo) ── */
    .about-bg-right {
        position: absolute !important;
        top: 0;
        right: 0;
        width: 60%;
        height: 100%;
        background: #ffffff;
        z-index: 0 !important;
    }

    /* ── CONTENUTO: centrato, sovrapposto al video di sfondo ── */
    .about-container {
        position: relative;
        z-index: 2 !important;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        box-sizing: border-box;
    }

    .about-main-card {
        background: white;
        overflow: hidden;
        border-radius: 1rem;
        box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.1);
        border: 1px solid #e2e8f0;
    }

    .about-layout {
        min-height: 520px;
    }

    .about-content-col {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 3rem;
    }

    .about-title {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: 2.25rem;
    }

    .about-description {
        color: var(--text-muted);
        line-height: 1.75;
        font-size: 1rem;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-weight: 400;
    }

    /* CTA */
    .about-cta {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 0.5rem;
        margin-top: 1.5rem;
        padding: 0.85rem 1.75rem;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-weight: 700;
        font-size: 0.95rem;
        color: #fff;
        background: var(--primary-color);
        border-radius: 0.5rem;
        text-decoration: none;
        transition: background 0.25s ease, transform 0.15s ease;
    }

    .about-cta:hover,
    .about-cta:focus-visible {
        background: var(--primary-hover);
        transform: translateY(-2px);
        color: #fff;
    }

    .cta-arrow {
        font-size: 1.15rem;
        transition: transform 0.2s ease;
    }

    .about-cta:hover .cta-arrow {
        transform: translateX(4px);
    }

    /* Stats spacing */
    .about-stats-container {
        margin-top: 3.5rem;
    }

    .about-stat-card {
        padding: 1.5rem 1rem;
    }

    @@media (max-width: 480px) {
        .about-bg-left {
            position: relative !important;
            width: 100%;
            height: 250px;
        }

        .about-bg-right {
            display: none;
        }

        .about-container {
            padding: 0 0.5rem !important;
        }

        .about-main-card {
            border-radius: 0.75rem;
        }

        .about-layout {
            min-height: auto;
        }

        .about-content-col {
            padding: 1.5rem;
        }

        .about-title {
            font-size: 1.5rem !important;
        }

        .about-description {
            font-size: 0.9rem !important;
            line-height: 1.6 !important;
        }

        .about-cta {
            width: 100%;
            justify-content: center;
            padding: 0.75rem 1.25rem;
            font-size: 0.875rem;
        }

        .about-stats-container {
            padding: 0.75rem !important;
            margin-top: 2.5rem !important;
        }

        .about-stat-card {
            padding: 0.75rem 0.5rem !important;
        }

        .about-stat-number {
            font-size: 1.35rem !important;
        }

        .about-stat-suffix {
            font-size: 0.9rem !important;
        }

        .about-stat-label {
            font-size: 0.65rem !important;
        }

        .about-stat-icon {
            width: 36px !important;
            height: 36px !important;
            border-radius: 10px !important;
        }

        .about-stat-icon .rz-icon {
            font-size: 18px !important;
        }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .about-bg-left {
            position: relative !important;
            width: 100%;
            height: 300px;
        }

        .about-bg-right {
            display: none;
        }

        .about-container {
            padding: 0 1rem !important;
        }

        .about-layout {
            min-height: auto;
        }

        .about-content-col {
            padding: 2rem;
        }

        .about-title {
            font-size: 1.75rem !important;
        }

        .about-stats-container {
            margin-top: 3rem !important;
        }
    }
</style>
