@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject AboutViewModel ViewModel
@inject StatsViewModel StatsViewModel

<section id="about" class="lp-section">
    <div class="lp-container lp-about">
        <!-- media -->
        <div class="lp-about__media">
            <video autoplay muted loop playsinline class="lp-about__video">
                <source src="videos/about-bg.mp4?v=1" type="video/mp4" />
            </video>
            <div class="lp-about__media-badge">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#f59e0b"/></svg>
                Dal 2015
            </div>
        </div>

        <!-- content -->
        <div class="lp-about__content">
            <span class="lp-label">@ViewModel.SectionLabel</span>
            <RadzenText TextStyle="TextStyle.H3" class="lp-heading" Style="margin-bottom:1rem;">@ViewModel.Title</RadzenText>
            <RadzenText Text="@ViewModel.Description" class="lp-body" />

            <!-- pills from stats -->
            <div class="lp-about__pills">
                @foreach (var stat in StatsViewModel.StatCards)
                {
                    <span class="lp-pill">
                        <RadzenIcon Icon="@stat.Icon" Style="font-size:14px; vertical-align:middle; margin-right:4px;" />
                        @stat.Value@stat.Suffix @stat.Label
                    </span>
                }
            </div>

            <a href="@ViewModel.CtaHref" class="lp-btn lp-btn--primary" style="margin-top:2rem;align-self:flex-start;">
                @ViewModel.CtaText →
            </a>
        </div>
    </div>
</section>
