@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject AboutViewModel ViewModel
@inject StatsViewModel StatsViewModel

<section id="about" class="about-section full-page-section">
    @* Split background: video left 40%, white right 60% *@
    <div class="about-bg-left">
        <video autoplay muted loop playsinline>
            <source src="videos/about-bg.mp4?v=1" type="video/mp4" />
        </video>
        <div class="about-bg-left-overlay"></div>
    </div>
    <div class="about-bg-right"></div>

    <div class="about-container">
        @* Main card *@
        <div class="about-main-card glass-card gsap-fade-up">
            <div class="about-layout">
                <div class="about-content-col">
                    <span class="section-label">@ViewModel.SectionLabel</span>
                    <h3 class="about-title">@ViewModel.Title</h3>
                    <p class="about-description">@ViewModel.Description</p>
                    <a href="@ViewModel.CtaHref" class="btn-primary about-cta">
                        @ViewModel.CtaText
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
        </div>

        @* Stats *@
        <div class="about-stats-container gsap-fade-up">
            <RadzenRow Gap="20px" JustifyContent="JustifyContent.Center">
                @foreach (var stat in StatsViewModel.StatCards)
                {
                    <RadzenColumn Size="6" SizeSm="6" SizeLg="3">
                        <div class="about-stat-card">
                            <div class="about-stat-icon" style="background:linear-gradient(135deg,@stat.GradientStart 0%,@stat.GradientEnd 100%);">
                                <RadzenIcon Icon="@stat.Icon" Style="font-size:22px; color:white;" />
                            </div>
                            <div class="about-stat-content">
                                <div class="about-stat-value">
                                    <span class="about-stat-number">@stat.Value</span>
                                    <span class="about-stat-suffix">@stat.Suffix</span>
                                </div>
                                <div class="about-stat-label">@stat.Label</div>
                            </div>
                        </div>
                    </RadzenColumn>
                }
            </RadzenRow>
        </div>
    </div>

    <ScrollIndicator TargetSection="services" Text="Scopri i Servizi" />
</section>

<style>
    section#about,
    .about-section,
    .about-section.full-page-section {
        background: transparent !important;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
    }

    .about-bg-left {
        position: absolute !important;
        top: 0; left: 0;
        width: 40%; height: 100%;
        overflow: hidden;
        z-index: 0 !important;
    }

    .about-bg-left video {
        width: 100%; height: 100%;
        object-fit: cover;
    }

    .about-bg-left-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to right,
            rgba(15,23,42,0.35) 0%,
            rgba(3,105,161,0.15) 60%,
            rgba(255,255,255,0.5) 100%
        );
        z-index: 1;
    }

    .about-bg-right {
        position: absolute !important;
        top: 0; right: 0;
        width: 60%; height: 100%;
        background: #F8FAFC;
        z-index: 0 !important;
    }

    .about-container {
        position: relative;
        z-index: 2 !important;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .about-main-card {
        background: rgba(255,255,255,0.95) !important;
        overflow: hidden;
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-xl);
        border: 1px solid var(--border-color);
    }

    .about-layout { min-height: 480px; }

    .about-content-col {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 3rem;
    }

    .about-title {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 1rem;
        line-height: 1.25;
    }

    .about-description {
        color: var(--text-muted);
        line-height: 1.75;
        font-size: 1rem;
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        font-weight: 400;
        margin-bottom: 0;
    }

    .about-cta {
        align-self: flex-start;
        margin-top: 1.75rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    @@media (max-width: 480px) {
        .about-bg-left  { position: relative !important; width: 100%; height: 220px; }
        .about-bg-right { display: none; }
        .about-container { padding: 0 0.75rem !important; }
        .about-main-card { border-radius: var(--radius-lg); }
        .about-layout { min-height: auto; }
        .about-content-col { padding: 1.5rem; }
        .about-title { font-size: 1.5rem !important; }
        .about-description { font-size: 0.9rem !important; }
        .about-cta { width: 100%; justify-content: center; }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .about-bg-left  { position: relative !important; width: 100%; height: 260px; }
        .about-bg-right { display: none; }
        .about-container { padding: 0 1rem !important; }
        .about-layout   { min-height: auto; }
        .about-content-col { padding: 2rem; }
        .about-title    { font-size: 1.75rem !important; }
    }
</style>
