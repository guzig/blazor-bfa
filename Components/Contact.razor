@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject ContactViewModel ViewModel

<section id="contact" class="lp-section lp-section--dark">
    <div class="lp-container lp-contact">
        <!-- Left: info -->
        <div class="lp-contact__info">
            <span class="lp-label lp-label--light">@ViewModel.SectionLabel</span>
            <RadzenText TextStyle="TextStyle.H3" class="lp-heading" Style="color:#fff; margin-top:.5rem;">
                @ViewModel.Title <span style="color:#00a8e8;">@ViewModel.TitleHighlight</span>
            </RadzenText>
            <p class="lp-body" style="color:rgba(255,255,255,.7); margin-top:1.25rem;">
                Parla con un nostro esperto senza impegno. Analizziamo la tua situazione e ti proponiamo soluzioni concrete.
            </p>

            <div class="lp-contact__details">
                @foreach (var info in ViewModel.ContactInfo)
                {
                    <div class="lp-contact__detail">
                        <RadzenIcon Icon="@info.Icon" Style="color:#7dd3fc; font-size:20px; flex-shrink:0;" />
                        <a href="@info.Href">@info.Value</a>
                    </div>
                }
                <div class="lp-contact__detail">
                    <RadzenIcon Icon="place" Style="color:#7dd3fc; font-size:20px; flex-shrink:0;" />
                    <span>@ViewModel.AddressStreet – @ViewModel.AddressCity</span>
                </div>
            </div>
        </div>

        <!-- Right: form -->
        <div class="lp-contact__form">
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="lp-contact__success">
                    <svg width="40" height="40" fill="none" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <h3>Messaggio inviato!</h3>
                    <p>Ti risponderemo entro 24 ore.</p>
                </div>
            }
            else
            {
                <h3 class="lp-contact__form-title">@ViewModel.FormTitle</h3>
                <RadzenTemplateForm Data="@formData" TItem="FormData" Submit="HandleSubmit">
                    <div class="lp-form-row">
                        <div class="lp-form-group">
                            <RadzenLabel Text="Nome e Cognome" Style="font-size:.85rem; font-weight:600;" />
                            <RadzenTextBox @bind-Value="formData.Name" Placeholder="Mario Rossi" Style="width:100%;" Name="Name" />
                        </div>
                        <div class="lp-form-group">
                            <RadzenLabel Text="Email" Style="font-size:.85rem; font-weight:600;" />
                            <RadzenTextBox @bind-Value="formData.Email" Placeholder="mario@comune.it" Style="width:100%;" Name="Email" />
                        </div>
                    </div>
                    <div class="lp-form-group">
                        <RadzenLabel Text="Organizzazione" Style="font-size:.85rem; font-weight:600;" />
                        <RadzenTextBox @bind-Value="formData.Subject" Placeholder="Comune di..." Style="width:100%;" Name="Subject" />
                    </div>
                    <div class="lp-form-group">
                        <RadzenLabel Text="Messaggio" Style="font-size:.85rem; font-weight:600;" />
                        <RadzenTextArea @bind-Value="formData.Message" Rows="4" Placeholder="Descrivi la tua esigenza energetica..." Style="width:100%; resize:vertical;" Name="Message" />
                    </div>
                    <RadzenButton ButtonType="ButtonType.Submit"
                                  Text="@ViewModel.SubmitButtonText"
                                  Icon="@ViewModel.SubmitButtonIcon"
                                  Style="width:100%; border-radius:9999px; background:#0070a0; border:none; padding:.875rem 2rem; font-weight:700;" />
                </RadzenTemplateForm>
            }
        </div>
    </div>
</section>

<style>
    /* Override Radzen textbox/textarea inside dark contact section */
    .lp-section--dark .rz-textbox,
    .lp-section--dark .rz-textarea {
        border: 1.5px solid var(--lp-border) !important;
        border-radius: var(--lp-radius) !important;
        font-family: var(--lp-font) !important;
        padding: .75rem 1rem !important;
        font-size: .95rem !important;
    }
    .lp-section--dark .rz-textbox:focus,
    .lp-section--dark .rz-textarea:focus {
        border-color: var(--lp-blue) !important;
        box-shadow: 0 0 0 3px rgba(0,112,160,.12) !important;
    }
</style>

@code {
    private FormData formData = new();
    private string? successMessage;

    private void HandleSubmit(FormData _)
    {
        successMessage = "Messaggio inviato! Ti risponderemo al più presto.";
        formData = new FormData();
    }

    private class FormData
    {
        public string Name    { get; set; } = string.Empty;
        public string Email   { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}
