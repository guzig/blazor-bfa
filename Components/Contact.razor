@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject ContactViewModel ViewModel

<section id="contatti" class="section-screen py-24 bg-background relative">
    <div class="absolute inset-0 overflow-hidden -z-10">
        <div class="absolute right-0 bottom-0 translate-y-1/2 translate-x-1/3 w-[800px] h-[800px] bg-primary/5 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <div class="reveal reveal-left">
                <div class="inline-flex items-center gap-2 mb-4">
                    <span class="h-px w-8 bg-primary"></span>
                    <h3 class="text-primary font-semibold tracking-wider uppercase text-sm">@ViewModel.SectionLabel</h3>
                </div>
                <h2 class="text-4xl md:text-5xl font-display font-bold text-foreground mb-6">@ViewModel.Title <span class="text-gradient">@ViewModel.TitleHighlight</span></h2>
                <p class="text-lg text-muted-foreground mb-12 max-w-md">Siamo a tua disposizione per informazioni, chiarimenti e preventivi gratuiti sui nostri servizi.</p>

                <div class="space-y-8">
                    @foreach (var info in ViewModel.ContactInfo)
                    {
                        <a href="@info.Href" class="flex items-start">
                            <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mr-6 shadow-sm border border-primary/20">
                                <RadzenIcon Icon="@info.Icon" class="w-6 h-6" />
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">@info.Label</h4>
                                <p class="text-2xl font-display font-bold text-foreground hover:text-primary transition-colors">@info.Value</p>
                            </div>
                        </a>
                    }

                    <article class="flex items-start">
                        <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 mr-6 shadow-sm border border-primary/20">
                            <RadzenIcon Icon="place" class="w-6 h-6" />
                        </div>
                        <div>
                            <h4 class="text-sm font-semibold text-muted-foreground uppercase tracking-wider mb-1">Sede</h4>
                            <p class="text-xl font-display font-bold text-foreground">@ViewModel.AddressCity</p>
                            <p class="text-muted-foreground">@ViewModel.AddressStreet</p>
                        </div>
                    </article>
                </div>
            </div>

            <div class="bg-card border border-border/60 rounded-2xl p-8 shadow-lg reveal reveal-right" style="--reveal-delay: 140ms;">
                <h3 class="text-2xl font-display font-bold text-foreground mb-6">@ViewModel.FormTitle</h3>

                <RadzenTemplateForm Data="@formData" TItem="FormData" Submit="HandleSubmit" Class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <RadzenLabel Text="Nome" Component="Name" class="text-sm text-muted-foreground mb-2 block" />
                            <RadzenTextBox @bind-Value="formData.Name" Name="Name" class="w-full" />
                        </div>

                        <div>
                            <RadzenLabel Text="Email" Component="Email" class="text-sm text-muted-foreground mb-2 block" />
                            <RadzenTextBox @bind-Value="formData.Email" Name="Email" class="w-full" />
                        </div>
                    </div>

                    <div>
                        <RadzenLabel Text="Oggetto" Component="Subject" class="text-sm text-muted-foreground mb-2 block" />
                        <RadzenTextBox @bind-Value="formData.Subject" Name="Subject" class="w-full" />
                    </div>

                    <div>
                        <RadzenLabel Text="Messaggio" Component="Message" class="text-sm text-muted-foreground mb-2 block" />
                        <RadzenTextArea @bind-Value="formData.Message" Name="Message" Rows="6" class="w-full" />
                    </div>

                    <RadzenButton ButtonType="ButtonType.Submit" Text="@ViewModel.SubmitButtonText" Icon="@ViewModel.SubmitButtonIcon" Class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium border border-primary-border min-h-10 h-12 px-6 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl" />
                </RadzenTemplateForm>

                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <RadzenAlert Severity="AlertSeverity.Success" Class="mt-4">@successMessage</RadzenAlert>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private FormData formData = new();
    private string? successMessage;

    private void HandleSubmit(FormData _)
    {
        successMessage = "Messaggio inviato! Ti risponderemo al pi&ugrave; presto.";
        formData = new FormData();
    }

    private class FormData
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}