@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject TestimonialsViewModel ViewModel

<section id="testimonials" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <span class="lp-label">I nostri clienti</span>
            <RadzenText TextStyle="TextStyle.H3" Class="lp-heading">
                Cosa dicono di <span class="lp-accent">noi</span>
            </RadzenText>
        </div>
    </div>

    <div class="lp-testimonials-outer">
        <div class="lp-testimonials-track">
            @foreach (var pass in Enumerable.Range(0, 2))
            {
                foreach (var t in ViewModel.Testimonials)
                {
                    string initials = t.Name?.Length >= 2
                        ? t.Name[..2].ToUpper()
                        : (t.Name ?? "??").ToUpper();

                    <div class="lp-testimonial-card">
                        <div class="lp-testimonial-stars">
                            @for (int i = 0; i < t.Rating; i++) { <span>★</span> }
                            @for (int i = t.Rating; i < 5; i++) { <span style="opacity:.3;">★</span> }
                        </div>
                        <p class="lp-testimonial-text">"@t.Content"</p>
                        <div class="lp-testimonial-author">
                            <div class="lp-testimonial-avatar">@initials</div>
                            <div>
                                <strong>@t.Name</strong>
                                <span>@t.Role</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <ScrollIndicator TargetSection="contact" NextLabel="Contatti" />
</section>
