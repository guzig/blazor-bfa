@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject TestimonialsViewModel ViewModel

<section id="testimonials" class="full-page-section" style="background:#FFFFFF;">
    <div class="testimonials-header gsap-fade-up" style="text-align:center; margin-bottom:3rem; padding:0 1rem;">
        <span class="section-label">Testimonial</span>
        <h2 class="section-title">
            I nostri
            <span style="background:var(--gradient-hero-text); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
                Testimonial
            </span>
        </h2>
        <p style="color:var(--text-muted); margin-top:0.5rem; font-family:'Plus Jakarta Sans',sans-serif; font-size:1rem;">
            Cosa dicono di noi
        </p>
    </div>

    <div class="testimonials-slideshow-container gsap-fade-up">
        <div class="testimonials-slideshow-track">
            @foreach (var testimonial in ViewModel.Testimonials)
            {
                <div class="testimonials-slideshow-card">
                    <div class="testimonial-card glass-card">
                        <div style="display:flex; flex-direction:column; align-items:center; gap:1rem;">
                            <div style="color:var(--accent-color);">
                                <RadzenRating Value="testimonial.Rating" Max="5" ReadOnly="true" />
                            </div>
                            <p class="testimonial-content">"@testimonial.Content"</p>
                            <div class="testimonial-divider"></div>
                            <p class="testimonial-name">@testimonial.Name</p>
                            <p class="testimonial-role">@testimonial.Role</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <ScrollIndicator TargetSection="contact" Text="Contattaci" />
</section>

<style>
    .testimonial-card {
        padding: 2.5rem 2rem;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-xl) !important;
        box-shadow: var(--shadow-md) !important;
        background: #FFFFFF !important;
        text-align: center;
    }

    .testimonial-content {
        font-style: italic;
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.8;
        font-family: 'Plus Jakarta Sans', sans-serif;
        max-width: 560px;
        margin: 0 auto;
    }

    .testimonial-divider {
        width: 48px;
        height: 3px;
        background: var(--gradient-primary);
        border-radius: 2px;
        margin: 0 auto;
    }

    .testimonial-name {
        font-weight: 700;
        color: var(--text-dark);
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.1rem;
    }

    .testimonial-role {
        color: var(--text-light);
        font-size: 0.875rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    @@media (max-width: 480px) {
        .testimonial-card   { padding: 1.5rem 1rem !important; }
        .testimonial-content{ font-size: 0.9rem !important; line-height: 1.65 !important; }
        .testimonials-slideshow-container { margin: 1rem 0.5rem !important; }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .testimonial-card { padding: 2rem 1.5rem !important; }
    }
</style>
