@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject TestimonialsViewModel ViewModel

<section id="testimonials" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <span class="lp-label">I nostri clienti</span>
            <RadzenText TextStyle="TextStyle.H3" class="lp-heading">
                Cosa dicono di <span class="lp-accent">noi</span>
            </RadzenText>
        </div>

        <div class="lp-testimonials">
            @{ int idx = 0; }
            @foreach (var testimonial in ViewModel.Testimonials)
            {
                bool featured = (idx == 1);
                <RadzenCard class="@($"lp-testimonial {(featured ? "lp-testimonial--featured" : "")}")" Style="padding:2rem;">
                    <div class="lp-testimonial__stars">
                        @for (int i = 0; i < testimonial.Rating; i++) { <span>★</span> }
                        @for (int i = testimonial.Rating; i < 5; i++) { <span style="opacity:.3;">★</span> }
                    </div>
                    <RadzenText Text="@testimonial.Content" class="lp-testimonial__text" />
                    <div class="lp-testimonial__author">
                        <div class="lp-testimonial__avatar">
                            @(testimonial.Name.Length >= 2 ? testimonial.Name[..2].ToUpper() : testimonial.Name.ToUpper())
                        </div>
                        <div>
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="font-weight:700; display:block;">@testimonial.Name</RadzenText>
                            <RadzenText Style="font-size:.8rem;">@testimonial.Role</RadzenText>
                        </div>
                    </div>
                </RadzenCard>
                idx++;
            }
        </div>
    </div>
</section>
