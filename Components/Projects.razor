@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject ProjectsViewModel ViewModel

<section id="projects" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <span class="lp-label">Il nostro Portfolio</span>
            <RadzenText TextStyle="TextStyle.H3" Class="lp-heading">
                Amministrazioni Comunali <span class="lp-accent">Servite</span>
            </RadzenText>
        </div>
    </div>
    <div style="width:100%; margin-top:2.5rem;">
    <div class="lp-projects-carousel">
        <div class="lp-projects-track">
            @for (int pass = 0; pass < 2; pass++)
            {
                @foreach (var project in ViewModel.Projects)
                {
                    <div class="lp-project-card">
                        <div class="lp-project-card__icon">
                            <RadzenIcon Icon="location_city" Style="font-size:26px;" />
                        </div>
                        <h4>@project.Name</h4>
                        <span>(@project.Province)</span>
                        <div>
                            <RadzenBadge Text="@($"Dal {project.Year}")" class="lp-project-card__badge" Style="background:#eff6ff; color:#0070a0; border:1px solid #bfdbfe;" />
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    </div>
    <ScrollIndicator TargetSection="testimonials" NextLabel="Testimonial" />
</section>
