@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel

<section id="features" class="section-screen choose-us-section bg-muted/30 relative flex flex-col overflow-hidden pt-24">
    <div class="w-full h-px bg-border/60 mb-6"></div>
    <div class="absolute right-0 top-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-24 w-full">

        <div class="text-center max-w-2xl mx-auto mb-8 reveal">
            <div class="inline-flex items-center gap-2 mb-4 justify-center w-full">
                <span class="h-px w-8 bg-primary"></span>
                <h3 class="text-primary font-semibold tracking-wider uppercase text-sm">@ViewModel.BadgeText</h3>
                <span class="h-px w-8 bg-primary"></span>
            </div>
            <h2 class="text-4xl md:text-5xl font-display font-bold text-foreground mb-4">
                @ViewModel.Title
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400"> @ViewModel.TitleHighlight</span>
            </h2>
            <p class="text-muted-foreground text-lg">@ViewModel.Description</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
            @for (var i = 0; i < ViewModel.Stats.Count; i++)
            {
                var stat = ViewModel.Stats[i];
                <div class="relative bg-card border border-border/50 rounded-2xl p-8 text-center overflow-hidden group hover:border-primary/30 hover:shadow-lg transition-all reveal" style="--reveal-delay: @(i * 120)ms;">
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <RadzenIcon Icon="@stat.Icon" style="font-size:1.75rem;color:hsl(var(--primary));display:block;margin:0 auto 1rem" />
                    <p class="text-5xl font-display font-black text-foreground mb-1 group-hover:text-primary transition-colors">@stat.Value</p>
                    <p class="text-sm font-semibold text-foreground/70 uppercase tracking-wider mb-2">@stat.Label</p>
                    <p class="text-xs text-muted-foreground leading-relaxed">@stat.Description</p>
                </div>
            }
        </div>

        <div class="space-y-4">
            @for (var i = 0; i < ViewModel.Features.Count; i++)
            {
                var feature = ViewModel.Features[i];
                <div class="flex items-start gap-6 bg-card border border-border/50 rounded-2xl p-6 hover:shadow-md hover:border-primary/20 transition-all group reveal" style="--reveal-delay: @(i * 100)ms;">
                    <div class="shrink-0 w-12 h-12 rounded-xl flex items-center justify-center shadow-md" style="background-image: @feature.GradientStyle;">
                        <RadzenIcon Icon="@feature.Icon" style="font-size:1.5rem;color:white" />
                    </div>
                    <div>
                        <h4 class="text-base font-display font-bold text-foreground mb-1 group-hover:text-primary transition-colors">@feature.Title</h4>
                        <p class="text-muted-foreground text-sm leading-relaxed">@feature.Description</p>
                    </div>
                </div>
            }
        </div>

        <div class="mt-14 rounded-2xl p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl reveal" style="background-image: linear-gradient(to right, hsl(var(--primary) / 0.9), rgb(52 211 153 / 0.9)); --reveal-delay: 300ms;">
            <div class="text-white">
                <p class="text-xs font-semibold uppercase tracking-widest opacity-80 mb-1">@ViewModel.CtaLabel</p>
                <p class="text-2xl font-display font-bold">@ViewModel.CtaTitle</p>
            </div>
            <a href="#contatti" class="shrink-0 px-8 py-3 bg-white font-bold rounded-xl hover:bg-white/90 transition-colors shadow-md whitespace-nowrap" style="color:hsl(var(--primary))">
                @ViewModel.CtaButton
            </a>
        </div>

    </div>

    <ScrollIndicatorComponentView TargetSection="portfolio" Text="Scorri" Variant="dark" />
</section>
