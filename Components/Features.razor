@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel

<section id="features" class="bg-muted/30 pb-24 relative overflow-hidden">
    <div class="w-full h-px bg-border/60 mb-16"></div>
    <div class="absolute right-0 top-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16 reveal">
            <div class="inline-flex items-center gap-2 mb-4 justify-center w-full">
                <span class="h-px w-8 bg-primary"></span>
                <h3 class="text-primary font-semibold tracking-wider uppercase text-sm">@ViewModel.BadgeText</h3>
                <span class="h-px w-8 bg-primary"></span>
            </div>
            <h2 class="text-4xl md:text-5xl font-display font-bold text-foreground mb-4">@ViewModel.Title <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">@ViewModel.TitleHighlight</span> @ViewModel.TitleEnd</h2>
            <p class="text-muted-foreground text-lg">@ViewModel.Description</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-16">
            @for (var i = 0; i < ViewModel.FloatingBadges.Count; i++)
            {
                var badge = ViewModel.FloatingBadges[i];
                <article class="relative bg-card border border-border/50 rounded-2xl p-8 text-center overflow-hidden group hover:border-primary/30 hover:shadow-lg transition-all reveal" style="--reveal-delay: @(i * 90)ms;">
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <RadzenIcon Icon="@badge.Icon" class="w-7 h-7 text-primary mx-auto mb-4" />
                    <p class="text-xl font-display font-bold text-foreground relative z-10">@badge.Text</p>
                </article>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-border/60 bg-card reveal reveal-left">
                <img src="@ViewModel.ImagePath" alt="@ViewModel.ImageAlt" class="w-full h-full object-cover aspect-[4/3]" />
            </div>

            <div class="space-y-5">
                @for (var i = 0; i < ViewModel.Features.Count; i++)
                {
                    var feature = ViewModel.Features[i];
                    <article class="flex gap-4 rounded-xl border border-border/50 bg-card p-5 hover:border-primary/30 transition-colors reveal" style="--reveal-delay: @(120 + i * 80)ms;">
                        <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                            <RadzenIcon Icon="@feature.Icon" />
                        </div>
                        <div>
                            <h3 class="text-lg font-display font-semibold text-foreground">@feature.Title</h3>
                            <p class="text-muted-foreground">@feature.Description</p>
                        </div>
                    </article>
                }

                <a href="#contact" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium border border-primary-border min-h-10 h-12 px-6 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl">
                    @ViewModel.ButtonText
                    <RadzenIcon Icon="@ViewModel.ButtonIcon" />
                </a>
            </div>
        </div>
    </div>
</section>