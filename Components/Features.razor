@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel
@inject NavigationManager NavigationManager

<section id="features" class="features-section full-page-section">
    <div class="features-container">
        <RadzenRow AlignItems="AlignItems.Center" Gap="4rem" JustifyContent="JustifyContent.Center">
            @* Left content *@
            <RadzenColumn Size="12" SizeLg="5">
                <div class="features-content gsap-fade-up">
                    @* Badge *@
                    <div class="features-badge gsap-fade-up">
                        <RadzenIcon Icon="star" Style="font-size:16px; color:var(--primary-color);" />
                        <span>@ViewModel.BadgeText</span>
                    </div>

                    @* Title *@
                    <h2 class="features-title gsap-fade-up">
                        @ViewModel.Title<br />
                        <span class="features-title-highlight">@ViewModel.TitleHighlight</span>
                        @if (!string.IsNullOrEmpty(ViewModel.TitleEnd))
                        {
                            <span> @ViewModel.TitleEnd</span>
                        }
                    </h2>

                    @* Description *@
                    <p class="features-description gsap-fade-up">@ViewModel.Description</p>

                    @* Features list *@
                    <div class="features-list" style="margin-bottom:2.5rem;">
                        @foreach (var feature in ViewModel.Features)
                        {
                            <div class="feature-item gsap-fade-up">
                                <div class="feature-icon-wrap" style="background:@feature.IconBg;">
                                    <RadzenIcon Icon="@feature.Icon" Style="@($"color:{feature.IconColor}; font-size:20px;")" />
                                </div>
                                <div class="feature-text">
                                    <p class="feature-item-title">@feature.Title</p>
                                    <p class="feature-item-desc">@feature.Description</p>
                                </div>
                            </div>
                        }
                    </div>

                    @* CTA *@
                    <button class="btn-primary gsap-fade-up" @onclick="@(() => NavigationManager.NavigateTo("#contact"))">
                        <RadzenIcon Icon="@ViewModel.ButtonIcon" Style="font-size:18px;" />
                        @ViewModel.ButtonText
                    </button>
                </div>
            </RadzenColumn>

            @* Right image *@
            <RadzenColumn Size="12" SizeLg="6">
                <div class="features-image-container gsap-scale-in">
                    <div class="features-image-wrapper">
                        <RadzenImage Path="@ViewModel.ImagePath" Alt="@ViewModel.ImageAlt" Class="features-main-image" />
                        <div class="features-image-overlay"></div>
                    </div>

                    @foreach (var badge in ViewModel.FloatingBadges)
                    {
                        <div class="floating-badge @badge.PositionClass">
                            <RadzenIcon Icon="@badge.Icon" Style="@($"color:{badge.IconColor}; font-size:16px;")" />
                            <span>@badge.Text</span>
                        </div>
                    }
                </div>
            </RadzenColumn>
        </RadzenRow>
    </div>

    <ScrollIndicator TargetSection="projects" Text="I Nostri Progetti" />
</section>

<style>
    /* Features section – light gradient bg */
    .features-section {
        background: linear-gradient(180deg, #F0F9FF 0%, #F0FDFA 100%) !important;
    }

    .features-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Badge */
    .features-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, rgba(3,105,161,0.08) 0%, rgba(20,184,166,0.08) 100%);
        border: 1px solid rgba(3,105,161,0.15);
        color: var(--primary-color);
        padding: 0.4rem 1rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Title */
    .features-title {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 700;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        margin-bottom: 1.25rem;
        color: var(--text-dark);
    }

    .features-title-highlight {
        background: var(--gradient-hero-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .features-description {
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.75;
        margin-bottom: 2rem;
        max-width: 480px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Feature items */
    .features-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .feature-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .feature-item-title {
        font-weight: 600;
        color: var(--text-dark);
        font-size: 1rem;
        margin-bottom: 3px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .feature-item-desc {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.6;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Image */
    .features-image-container {
        position: relative;
    }

    .features-image-wrapper {
        position: relative;
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: var(--shadow-xl);
    }

    .features-main-image {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 1.25rem;
    }

    .features-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(3,105,161,0.08) 0%, rgba(20,184,166,0.05) 100%);
        border-radius: 1.25rem;
        pointer-events: none;
    }

    /* Floating badges */
    .floating-badge {
        position: absolute;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.7);
        border-radius: 0.75rem;
        padding: 0.6rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-dark);
        box-shadow: var(--shadow-md);
        font-family: 'Plus Jakarta Sans', sans-serif;
        animation: floatBadge 3s ease-in-out infinite alternate;
    }

    .floating-badge.top-left    { top: 1.5rem; left: -1rem; animation-delay: 0s; }
    .floating-badge.top-right   { top: 1.5rem; right: -1rem; animation-delay: 0.5s; }
    .floating-badge.bottom-left { bottom: 1.5rem; left: -1rem; animation-delay: 1s; }
    .floating-badge.bottom-right{ bottom: 1.5rem; right: -1rem; animation-delay: 1.5s; }

    @@keyframes floatBadge {
        0%   { transform: translateY(0); }
        100% { transform: translateY(-6px); }
    }

    /* CTA button */
    .features-section .btn-primary {
        padding: 0.875rem 2rem;
        font-size: 1rem;
        border: none;
        cursor: pointer;
    }

    @@media (max-width: 480px) {
        .features-title     { font-size: 1.75rem; line-height: 1.25; }
        .features-description { font-size: 0.95rem; max-width: 100%; }
        .features-badge     { font-size: 0.8rem; padding: 0.35rem 0.875rem; }

        .features-section .btn-primary {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .features-title { font-size: 2rem; }
        .features-content { text-align: center; }
        .features-description { max-width: 100%; margin-left: auto; margin-right: auto; }
    }
</style>
