@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel
@inject NavigationManager NavigationManager

<section id="features" class="lp-section">
    <div class="lp-container">
        <div class="lp-section-header">
            <div class="lp-features-badge">
                <RadzenIcon Icon="star" Style="font-size:14px; color:#0070a0;" />
                <span>@ViewModel.BadgeText</span>
            </div>
            <RadzenText TextStyle="TextStyle.H3" Class="lp-heading" Style="margin-top:.75rem;">
                @ViewModel.Title <span class="lp-accent">@ViewModel.TitleHighlight</span> @ViewModel.TitleEnd
            </RadzenText>
            <RadzenText Class="lp-body lp-section-header__sub" Text="@ViewModel.Description" />
        </div>

        <!-- Feature grid (icon + title + description) -->
        <div class="lp-features-grid">
            @foreach (var feature in ViewModel.Features)
            {
                <div class="lp-feature">
                    <div class="lp-feature__icon">
                        <RadzenIcon Icon="@feature.Icon" Style="@($"font-size:28px; color:{feature.IconColor};")" />
                    </div>
                    <h4>@feature.Title</h4>
                    <p>@feature.Description</p>
                </div>
            }
        </div>

        <div style="text-align:center; margin-top:3rem;">
            <RadzenButton Text="@ViewModel.ButtonText" Icon="@ViewModel.ButtonIcon"
                          Class="lp-btn lp-btn--primary"
                          Style="border-radius:9999px; padding:.875rem 2rem; font-weight:700;"
                          Click="@(() => NavigationManager.NavigateTo("#contact"))" />
        </div>
    </div>
</section>
