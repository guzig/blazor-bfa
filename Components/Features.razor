@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel
@inject NavigationManager NavigationManager

<section id="features" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <span class="lp-label">@ViewModel.BadgeText</span>
            <RadzenText TextStyle="TextStyle.H3" Class="lp-heading" Style="margin-top:.75rem;">
                @ViewModel.Title <span class="lp-accent">@ViewModel.TitleHighlight</span> @ViewModel.TitleEnd
            </RadzenText>
            <RadzenText Class="lp-body lp-section-header__sub" Text="@ViewModel.Description" />
        </div>

        <div class="lp-services-grid">
            @foreach (var feature in ViewModel.Features)
            {
                <div class="lp-service-card" style="--bullet-color:@feature.IconColor; border-top:3px solid @feature.IconColor; background:#fff;">
                    <div class="lp-service-card__icon" style="background:@feature.IconBg;">
                        <RadzenIcon Icon="@feature.Icon" Style="@($"color:{feature.IconColor}; font-size:22px;")" />
                    </div>
                    <h3>@feature.Title</h3>
                    <p>@feature.Description</p>
                </div>
            }
        </div>

        <div style="text-align:center; margin-top:3rem;">
            <a href="#contact" class="lp-btn lp-btn--primary" style="border-radius:9999px; padding:.875rem 2rem; font-weight:700; display:inline-flex; align-items:center; gap:.5rem; text-decoration:none;">
                <RadzenIcon Icon="@ViewModel.ButtonIcon" Style="font-size:18px;" />
                @ViewModel.ButtonText
            </a>
        </div>
    </div>
    <ScrollIndicator TargetSection="projects" NextLabel="Progetti" />
</section>
