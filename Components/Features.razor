@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject FeaturesViewModel ViewModel

<section id="features" class="section-screen choose-us-section bg-muted/30 relative flex flex-col">
    <div class="w-full h-px bg-border/60 mb-8"></div>
    <div class="absolute right-0 top-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-3xl -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-8 reveal">
            <div class="inline-flex items-center gap-2 mb-4 justify-center w-full">
                <span class="h-px w-8 bg-primary"></span>
                <h3 class="text-primary font-semibold tracking-wider uppercase text-sm">@ViewModel.BadgeText</h3>
                <span class="h-px w-8 bg-primary"></span>
            </div>
            <h2 class="text-4xl md:text-5xl font-display font-bold text-foreground mb-4">@ViewModel.Title <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-400">@ViewModel.TitleHighlight</span> @ViewModel.TitleEnd</h2>
            <p class="text-muted-foreground text-lg">@ViewModel.Description</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            @for (var i = 0; i < ViewModel.FloatingBadges.Count; i++)
            {
                var badge = ViewModel.FloatingBadges[i];
                <article class="group flex items-center gap-4 bg-card border border-border/60 rounded-2xl p-5 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/8 hover:-translate-y-0.5 transition-all duration-300 reveal" style="--reveal-delay: @(i * 90)ms;">
                    <div class="shrink-0 w-12 h-12 rounded-xl bg-primary/12 ring-1 ring-primary/25 flex items-center justify-center group-hover:bg-primary group-hover:ring-0 group-hover:shadow-md group-hover:shadow-primary/30 transition-all duration-300">
                        <RadzenIcon Icon="@badge.Icon" class="w-6 h-6 text-primary group-hover:text-white transition-colors duration-300" />
                    </div>
                    <div>
                        <p class="font-display font-semibold text-foreground text-base">@badge.Text</p>
                        <p class="text-xs text-muted-foreground mt-0.5">Garantito</p>
                    </div>
                </article>
            }
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
            <div class="relative rounded-2xl overflow-hidden shadow-xl border border-border/60 bg-card reveal reveal-left choose-us-image-frame">
                <img src="@ViewModel.ImagePath" alt="@ViewModel.ImageAlt" class="w-full h-full object-cover aspect-[4/3]" />
            </div>

            <div class="space-y-5">
                @for (var i = 0; i < ViewModel.Features.Count; i++)
                {
                    var feature = ViewModel.Features[i];
                    <article class="choose-us-card group rounded-xl border border-border/50 bg-card p-5 reveal" style="--reveal-delay: @(120 + i * 80)ms;">
                        <div class="choose-us-card-glow" aria-hidden="true"></div>
                        <div class="choose-us-card-content">
                            <div class="choose-us-icon-wrap" style="background: @feature.IconBg; color: @feature.IconColor;">
                                <RadzenIcon Icon="@feature.Icon" class="choose-us-icon" />
                            </div>
                            <div class="choose-us-copy">
                                <h3 class="text-lg font-display font-semibold text-foreground">@feature.Title</h3>
                                <p class="text-muted-foreground">@feature.Description</p>
                            </div>
                            <div class="choose-us-arrow" aria-hidden="true">
                                <RadzenIcon Icon="arrow_outward" />
                            </div>
                        </div>
                    </article>
                }

                <a href="#contact" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium border border-primary-border min-h-10 h-12 px-6 bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl">
                    @ViewModel.ButtonText
                    <RadzenIcon Icon="@ViewModel.ButtonIcon" />
                </a>
            </div>
        </div>
    </div>
    <ScrollIndicator TargetSection="portfolio" Text="Scorri" Variant="dark" />
</section>