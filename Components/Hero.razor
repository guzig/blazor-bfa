@using BlazorBFA.ViewModels
@inject HeroViewModel ViewModel
@inject IJSRuntime JS

<section id="home" class="lp-hero">
    <video class="lp-hero__video" autoplay muted loop playsinline>
        <source src="videos/hero-video.mp4?v=3" type="video/mp4" />
    </video>
    <div class="lp-hero__overlay"></div>

    <div class="lp-container lp-hero__body">
        <div class="lp-hero__tag">@ViewModel.Label</div>
        <h1 class="lp-hero__title">
            @ViewModel.Title<br/>
            <span class="lp-hero__accent">@ViewModel.TitleHighlight</span>
        </h1>
        <p class="lp-hero__sub">@ViewModel.Subtitle</p>
        <div class="lp-hero__ctas">
            <a href="#services" class="lp-btn lp-btn--primary">@ViewModel.PrimaryButtonText</a>
            <a href="#contact" class="lp-btn lp-btn--ghost">@ViewModel.SecondaryButtonText</a>
        </div>
    </div>

    <div class="lp-hero__scroll-indicator" @onclick="ScrollDown">
        <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
        </div>
        <span class="scroll-text">Scopri <strong>Chi Siamo</strong></span>
    </div>

    <div class="lp-hero__stats">
        <div class="lp-container lp-hero__stats-row">
            <div class="lp-hero__stat"><strong>50+</strong><span>Comuni Serviti</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>2M €</strong><span>Risparmi Generati</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>1000+</strong><span>Fatture Controllate</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>99%</strong><span>Efficienza Energetica</span></div>
        </div>
    </div>
</section>

@code {
    private async Task ScrollDown()
    {
        await JS.InvokeVoidAsync("scrollToSection", "about");
    }
}
