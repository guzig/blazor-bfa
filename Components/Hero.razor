@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject HeroViewModel ViewModel

<section class="hero-section hero-bg relative flex items-center justify-center overflow-hidden pt-20">

    @* Background layers — identici al React export *@
    <div class="absolute inset-0 z-0">
        <img src="/images/hero-bg.png" alt="BFA Consulting Energy Background" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-secondary/95 via-secondary/80 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-3xl">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 backdrop-blur-sm mb-6 reveal" style="--reveal-delay: 80ms;">
                <RadzenIcon Icon="verified_user" class="w-4 h-4 mr-2 text-primary" />
                <span class="text-sm font-medium" style="color: rgba(255,255,255,0.92);">@ViewModel.Label</span>
            </div>

            <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-bold leading-tight mb-6 reveal" style="color: #ffffff; --reveal-delay: 150ms;">
                @ViewModel.Title
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-emerald-300">@ViewModel.TitleHighlight</span>
            </h1>

            <p class="text-lg md:text-xl mb-10 max-w-2xl leading-relaxed reveal" style="color: rgba(255,255,255,0.82); --reveal-delay: 220ms;">@ViewModel.Subtitle</p>

            <div class="flex flex-col sm:flex-row gap-4 reveal" style="--reveal-delay: 300ms;">
                <a href="#contatti" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium min-h-10 w-full sm:w-auto h-14 px-8 text-base bg-primary hover:bg-primary/90 text-primary-foreground rounded-xl shadow-lg shadow-primary/30 group">
                    @ViewModel.PrimaryButtonText
                    <RadzenIcon Icon="@ViewModel.PrimaryButtonIcon" class="ml-2 w-5 h-5" />
                </a>
                <a href="#servizi" class="inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium min-h-10 w-full sm:w-auto h-14 px-8 text-base border border-white/20 text-white bg-white/5 hover:bg-white/10 backdrop-blur-sm rounded-xl" style="color:#fff;">
                    @ViewModel.SecondaryButtonText
                </a>
            </div>
        </div>
    </div>

    <ScrollIndicator TargetSection="chi-siamo" Text="Scorri" />
</section>
