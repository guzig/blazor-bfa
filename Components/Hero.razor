@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject HeroViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime JS

<section id="home" class="hero-section">
    @* Video background *@
    <div class="hero-video-background">
        <video autoplay muted loop playsinline class="hero-bg-video">
            <source src="videos/hero-video.mp4?v=3" type="video/mp4" />
        </video>
    </div>
    <div class="hero-overlay"></div>

    @* Decorative floating blobs (CSS ::before/::after handles them) *@

    <div class="hero-rows-container">
        <div class="hero-row-top"></div>

        <div class="hero-row-middle">
            <div class="hero-content">
                @* Label *@
                <div class="hero-label-container gsap-fade-up">
                    <span class="hero-label-line"></span>
                    <span class="section-label" style="margin:0;">@ViewModel.Label</span>
                </div>

                @* Title *@
                <h1 class="hero-title gsap-fade-up">
                    @ViewModel.Title
                    <span class="hero-title-highlight">@ViewModel.TitleHighlight</span>
                </h1>

                @* Subtitle *@
                <p class="hero-subtitle gsap-fade-up">@ViewModel.Subtitle</p>

                @* CTA Buttons *@
                <div class="hero-buttons gsap-fade-up">
                    <button class="btn-primary hero-btn" @onclick="ScrollToServices">
                        <RadzenIcon Icon="arrow_forward" Style="font-size:18px;" />
                        @ViewModel.PrimaryButtonText
                    </button>
                    <button class="btn-outline hero-btn" @onclick="ScrollToContact">
                        <RadzenIcon Icon="phone" Style="font-size:18px;" />
                        @ViewModel.SecondaryButtonText
                    </button>
                </div>
            </div>
        </div>

        <div class="hero-row-bottom"></div>
    </div>

    @* Scroll indicator *@
    <div class="hero-scroll-indicator" @onclick="ScrollToAbout" style="cursor:pointer;">
        <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
        </div>
        <span class="scroll-text">@ViewModel.ScrollText</span>
    </div>
</section>

<style>
    .hero-label-container {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .hero-label-line {
        display: none; /* section-label already has ::before pseudo */
    }

    .hero-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        color: var(--text-muted);
        margin-bottom: 2.25rem;
        line-height: 1.75;
        max-width: 580px;
        font-weight: 400;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: center;
    }

    .hero-btn {
        font-size: 0.95rem;
        padding: 0.875rem 1.75rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    @@media (max-width: 480px) {
        .hero-subtitle {
            font-size: 0.95rem;
            margin-bottom: 1.75rem;
        }

        .hero-buttons {
            flex-direction: column;
            width: 100%;
        }

        .hero-btn {
            width: 100%;
            justify-content: center;
            padding: 0.875rem 1.5rem;
        }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .hero-subtitle { font-size: 1rem; }
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("heroAnimations.init");
        }
    }

    private async Task ScrollToServices() => await JS.InvokeVoidAsync("scrollToSection", "services");
    private async Task ScrollToContact()  => await JS.InvokeVoidAsync("scrollToSection", "contact");
    private async Task ScrollToAbout()    => await JS.InvokeVoidAsync("scrollToSection", "about");
}
