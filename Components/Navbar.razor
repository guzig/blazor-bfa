@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject NavbarViewModel ViewModel
@inject NavigationManager Navigation
@inject IJSRuntime JS

<header class="site-header @(isScrolled ? "scrolled" : "")">
    <div style="max-width:1280px; margin:0 auto; width:100%; display:flex; align-items:center; justify-content:space-between; gap:1rem;">
        <a href="/" class="navbar-brand">@ViewModel.BrandName</a>

        <nav class="nav-links-desktop">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href" class="nav-link">@link.Name</a>
            }
        </nav>

        <div style="display:flex; align-items:center; gap:0.75rem;">
            <a href="#contact" class="btn-primary nav-cta-desktop" style="padding:0.6rem 1.4rem; font-size:0.875rem;">
                Contattaci
            </a>
            <button class="mobile-menu-btn" @onclick="ToggleMobileMenu" aria-label="Apri menu">
                <span class="hamburger-line @(isMobileMenuOpen ? "open" : "")"></span>
                <span class="hamburger-line @(isMobileMenuOpen ? "open" : "")"></span>
                <span class="hamburger-line @(isMobileMenuOpen ? "open" : "")"></span>
            </button>
        </div>
    </div>
</header>

@* Mobile Drawer *@
<div class="mobile-overlay @(isMobileMenuOpen ? "active" : "")" @onclick="CloseMobileMenu">
    <div class="mobile-drawer @(isMobileMenuOpen ? "active" : "")" @onclick:stopPropagation>
        <div class="mobile-drawer-header">
            <span class="navbar-brand">@ViewModel.BrandName</span>
            <button class="mobile-close-btn" @onclick="CloseMobileMenu" aria-label="Chiudi menu">
                <RadzenIcon Icon="close" Style="font-size:1.5rem; color:var(--text-dark);" />
            </button>
        </div>
        <nav class="mobile-nav-links">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href" class="mobile-nav-link" @onclick="CloseMobileMenu">
                    @link.Name
                </a>
            }
        </nav>
        <a href="#contact" class="btn-primary" style="margin:1rem 1.5rem; display:flex; justify-content:center;" @onclick="CloseMobileMenu">
            Contattaci
        </a>
    </div>
</div>

<style>
    /* Desktop nav */
    .nav-links-desktop {
        display: none;
        align-items: center;
        gap: 0.25rem;
    }

    .nav-cta-desktop { display: none; }

    @@media (min-width: 1024px) {
        .nav-links-desktop { display: flex !important; }
        .nav-cta-desktop   { display: inline-flex !important; }
        .mobile-menu-btn   { display: none !important; }
    }

    /* Hamburger */
    .mobile-menu-btn {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
        border-radius: 0.5rem;
        width: 40px;
        height: 40px;
        transition: background 0.2s ease;
    }

    .mobile-menu-btn:hover { background: rgba(3,105,161,0.08); }

    .hamburger-line {
        display: block;
        width: 22px;
        height: 2px;
        background: var(--text-dark);
        border-radius: 2px;
        transition: all 0.3s var(--ease-out);
        transform-origin: center;
    }

    .hamburger-line.open:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger-line.open:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .hamburger-line.open:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile overlay */
    .mobile-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,0.35);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        z-index: 998;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    /* Mobile drawer */
    .mobile-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 300px;
        max-width: 88vw;
        height: 100%;
        background: #FFFFFF;
        z-index: 999;
        transform: translateX(100%);
        transition: transform 0.35s cubic-bezier(0.16,1,0.3,1);
        box-shadow: -8px 0 32px rgba(15,23,42,0.12);
        display: flex;
        flex-direction: column;
    }

    .mobile-drawer.active { transform: translateX(0); }

    .mobile-drawer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .mobile-close-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0.4rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        transition: background 0.2s ease;
    }

    .mobile-close-btn:hover { background: rgba(15,23,42,0.05); }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        padding: 1rem 0;
        flex: 1;
    }

    .mobile-nav-link {
        color: var(--text-dark);
        font-weight: 500;
        font-size: 1rem;
        text-decoration: none;
        padding: 0.875rem 1.5rem;
        transition: background 0.2s ease, color 0.2s ease;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .mobile-nav-link:hover {
        background: var(--bg-light);
        color: var(--primary-color);
    }
</style>

@code {
    private bool isMobileMenuOpen = false;
    private bool isScrolled = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("navbarInterop.initialize", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void SetScrolled(bool scrolled)
    {
        isScrolled = scrolled;
        StateHasChanged();
    }

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;
}
