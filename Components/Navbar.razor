@using BlazorBFA.ViewModels
@inject NavbarViewModel ViewModel
@inject IJSRuntime JS

<header class="lp-nav @(scrolled ? "lp-nav--scrolled" : "")">
    <div class="lp-nav__inner">
        <a href="/" class="lp-nav__brand">@brandFirst <span>@brandRest</span></a>
        <nav class="lp-nav__links">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href">@link.Name</a>
            }
        </nav>
        <a href="#contact" class="lp-btn lp-btn--sm lp-btn--primary lp-nav__cta">Contattaci</a>
        <button class="lp-nav__burger" @onclick="ToggleMenu" aria-label="menu">
            <span></span><span></span><span></span>
        </button>
    </div>
    @if (menuOpen)
    {
        <nav class="lp-nav__mobile">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href" @onclick="CloseMenu">@link.Name</a>
            }
            <a href="#contact" class="lp-btn lp-btn--sm lp-btn--primary" style="margin-top:.5rem;border-radius:9999px;" @onclick="CloseMenu">Contattaci</a>
        </nav>
    }
</header>

@code {
    bool scrolled  = false;
    bool menuOpen  = false;
    string brandFirst = "BFA";
    string brandRest  = "Consulting";

    protected override void OnInitialized()
    {
        var parts = ViewModel.BrandName?.Split(' ', 2) ?? new[] { "BFA", "Consulting" };
        brandFirst = parts[0];
        brandRest  = parts.Length > 1 ? parts[1] : "";
    }

    void ToggleMenu() => menuOpen = !menuOpen;
    void CloseMenu()  => menuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initNavScroll");
        }
    }
}
