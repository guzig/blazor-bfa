@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject NavbarViewModel ViewModel

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="hidden md:block w-full bg-secondary text-secondary-foreground transition-all duration-300 py-2 opacity-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center text-sm">
            <div class="flex space-x-6">
                <a href="mailto:info@bfaconsulting.it" class="flex items-center hover:text-primary transition-colors">
                    <RadzenIcon Icon="mail" class="w-4 h-4 mr-2" />
                    info@bfaconsulting.it
                </a>
                <a href="tel:+390962123456" class="flex items-center hover:text-primary transition-colors">
                    <RadzenIcon Icon="phone" class="w-4 h-4 mr-2" />
                    +39 0962 123456
                </a>
            </div>
            <div class="font-medium text-primary">BFA Consulting - Gestione Energetica</div>
        </div>
    </div>

    <div class="w-full transition-all duration-300 bg-background/95 backdrop-blur-sm py-4 lg:py-5">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center">
                <a href="#" class="flex items-center gap-3 group" @onclick="CloseMobileMenu">
                    <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-primary to-blue-600 text-white shadow-lg group-hover:scale-105 transition-transform">
                        <img src="images/logo-mark.png" alt="BFA Logo" class="w-6 h-6 object-contain z-10 drop-shadow-md" />
                    </div>
                    <span class="font-display font-bold text-2xl tracking-tight text-foreground">BFA<span class="text-primary">.</span></span>
                </a>

                <nav class="hidden md:flex items-center space-x-8" aria-label="Primary navigation">
                    @foreach (var link in ViewModel.NavLinks)
                    {
                        <a href="@link.Href" class="text-sm font-medium text-foreground/80 hover:text-primary transition-colors relative after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-primary after:transition-all hover:after:w-full">@link.Name</a>
                    }
                    <a href="#contatti" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium border border-primary-border min-h-9 py-2 bg-primary hover:bg-primary/90 text-primary-foreground shadow-lg shadow-primary/25 rounded-full px-6 transition-all hover:scale-105">Preventivo Gratuito</a>
                </nav>

                <button class="md:hidden p-2 text-foreground" type="button" @onclick="ToggleMobileMenu" aria-label="Toggle menu">
                    <RadzenIcon Icon="@(isMobileMenuOpen ? "close" : "menu")" class="w-6 h-6" />
                </button>
            </div>
        </div>
    </div>

    @if (isMobileMenuOpen)
    {
        <div class="md:hidden border-t border-border/60 bg-background/95 backdrop-blur-lg">
            <div class="max-w-7xl mx-auto px-4 py-3 grid gap-1">
                @foreach (var link in ViewModel.NavLinks)
                {
                    <a href="@link.Href" class="px-3 py-2 rounded-lg text-foreground/90 hover:bg-muted" @onclick="CloseMobileMenu">@link.Name</a>
                }
                <a href="#contatti" class="mt-2 inline-flex items-center justify-center h-11 px-4 rounded-full bg-primary text-primary-foreground font-medium" @onclick="CloseMobileMenu">Preventivo Gratuito</a>
            </div>
        </div>
    }
</header>

@code {
    private bool isMobileMenuOpen;

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;
    private void CloseMobileMenu() => isMobileMenuOpen = false;

    private static string GetBrandText(string brandName)
    {
        return brandName.StartsWith("BFA ", StringComparison.OrdinalIgnoreCase)
            ? brandName[4..]
            : brandName;
    }
}
