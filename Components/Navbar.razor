@using BlazorBFA.ViewModels
@inject NavbarViewModel ViewModel
@inject IJSRuntime JS

<header class="lp-nav @(scrolled || menuOpen ? "lp-nav--scrolled" : "")">
    <div class="lp-nav__inner">
        <a href="/" class="lp-nav__brand">@brandFirst <span>@brandRest</span></a>
        <nav class="lp-nav__links">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href" style="color:#fff;font-weight:700;">@link.Name</a>
            }
        </nav>
        <button class="lp-nav__burger" @onclick="ToggleMenu" aria-label="menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

@if (menuOpen)
{
    <div class="lp-drawer__overlay" @onclick="CloseMenu"></div>
    <div class="lp-drawer">
        <div class="lp-drawer__header">
            <span class="lp-nav__brand" style="color:var(--lp-ink);">@brandFirst <span>@brandRest</span></span>
            <button class="lp-drawer__close" @onclick="CloseMenu" aria-label="chiudi">✕</button>
        </div>
        <nav class="lp-drawer__links">
            @foreach (var link in ViewModel.NavLinks)
            {
                <a href="@link.Href" @onclick="CloseMenu">@link.Name</a>
            }
        </nav>
    </div>
}

@code {
    bool scrolled  = false;
    bool menuOpen  = false;
    string brandFirst = "BFA";
    string brandRest  = "Consulting";

    protected override void OnInitialized()
    {
        var parts = ViewModel.BrandName?.Split(' ', 2) ?? new[] { "BFA", "Consulting" };
        brandFirst = parts[0];
        brandRest  = parts.Length > 1 ? parts[1] : "";
    }

    void ToggleMenu() => menuOpen = !menuOpen;
    void CloseMenu()  => menuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initNavScroll");
        }
    }
}
