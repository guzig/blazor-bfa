@using Radzen.Blazor
@using BlazorBFA.ViewModels

<article class="group bg-card rounded-2xl border transition-all duration-300 overflow-hidden cursor-pointer border-border/50 hover:border-primary/20 hover:shadow-md">
    <div class="p-7 flex items-start gap-5">
        <div class="shrink-0 w-14 h-14 rounded-xl flex items-center justify-center transition-all duration-300 text-white bg-primary/10 group-hover:bg-primary text-primary group-hover:text-white">
            <RadzenIcon Icon="@GetIcon(Service.Icon)" class="w-7 h-7" />
        </div>
        <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <span class="text-xs font-bold tracking-widest text-primary mb-1 block">@Index.ToString("00")</span>
                    <h3 class="text-lg font-display font-bold text-foreground leading-snug group-hover:text-primary transition-colors">@Service.Title</h3>
                </div>
            </div>
            <p class="text-muted-foreground text-sm mt-2 leading-relaxed">@Service.Description</p>

            <ul class="mt-3 space-y-1">
                @foreach (var feature in Service.Features.Take(2))
                {
                    <li class="flex items-start text-sm text-muted-foreground">
                        <RadzenIcon Icon="task_alt" class="text-primary mr-2 text-base" />
                        <span>@feature</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</article>

@code {
    [Parameter] public ServiceModel Service { get; set; } = new();
    [Parameter] public int Index { get; set; }

    private static string GetIcon(string icon) => icon switch
    {
        "file-check" => "fact_check",
        "settings" => "settings",
        "zap" => "electric_bolt",
        "scale" => "balance",
        "trending-down" => "trending_down",
        "eco" => "eco",
        _ => "info"
    };
}
