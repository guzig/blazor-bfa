@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels

<div class="lp-service-card" style="border-top:3px solid @Service.Color; background:@(Service.Color + "0d");">
    <div class="lp-service-card__icon" style="background:@(Service.Color + "22");">
        <RadzenIcon Icon="@GetIcon(Service.Icon)" Style="@($"color:{Service.Color}; font-size:22px;")" />
    </div>
    <h3>@Service.Title</h3>
    <p>@Service.Description</p>
    <ul>
        @foreach (var feature in Service.Features.Take(3))
        {
            <li style="--bullet-color:@Service.Color">@feature</li>
        }
    </ul>
</div>

@code {
    [Parameter] public ServiceModel Service { get; set; } = new();

    private static string GetIcon(string icon) => icon switch
    {
        "file-check"    => "task_alt",
        "settings"      => "settings",
        "zap"           => "bolt",
        "scale"         => "balance",
        "trending-down" => "trending_down",
        "eco"           => "eco",
        _               => "info"
    };
}
