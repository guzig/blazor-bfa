@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject ServicesViewModel ViewModel

<section id="services" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <span class="lp-label">@ViewModel.SectionLabel</span>
            <RadzenText TextStyle="TextStyle.H3" class="lp-heading">
                @ViewModel.Title <span class="lp-accent">@ViewModel.TitleHighlight</span>
            </RadzenText>
            <RadzenText class="lp-body lp-section-header__sub" Text="Soluzioni complete per ottimizzare la gestione energetica della tua organizzazione." />
        </div>

        <div class="lp-services-grid">
            @foreach (var service in ViewModel.Services)
            {
                <ServiceCard Service="service" />
            }
        </div>
    </div>
    <ScrollIndicator TargetSection="features" NextLabel="Perché Sceglierci" />
</section>
