@using Radzen
@using Radzen.Blazor
@using BlazorBFA.ViewModels
@inject ServicesViewModel ViewModel

<section id="services" class="full-page-section" style="background:#FFFFFF;">
    <div class="services-header gsap-fade-up" style="text-align:center; margin-bottom:3rem; padding:0 1rem;">
        <span class="section-label">@ViewModel.SectionLabel</span>
        <h2 class="section-title">
            @ViewModel.Title
            <span style="background:var(--gradient-hero-text); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
                @ViewModel.TitleHighlight
            </span>
        </h2>
    </div>

    <div class="services-grid-container">
        <RadzenRow Gap="24px" JustifyContent="JustifyContent.Center">
            @foreach (var service in ViewModel.Services)
            {
                <RadzenColumn Size="12" SizeMd="6">
                    <div class="gsap-fade-up">
                        <ServiceCard Service="service" />
                    </div>
                </RadzenColumn>
            }
        </RadzenRow>
    </div>

    <ScrollIndicator TargetSection="features" Text="Perché Sceglierci" />
</section>

<style>
    .services-grid-container {
        padding: 0 2rem;
        max-width: 1280px;
        margin: 0 auto;
    }

    @@media (max-width: 480px) {
        .services-grid-container { padding: 0 0.75rem; }
    }

    @@media (min-width: 481px) and (max-width: 768px) {
        .services-grid-container { padding: 0 1rem; }
    }
</style>
