@using BlazorBFA.ViewModels
@inject ServicesViewModel ViewModel

<section id="servizi" class="py-24 bg-muted/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
            <div class="inline-flex items-center gap-2 mb-4 justify-center w-full">
                <span class="h-px w-8 bg-primary"></span>
                <h3 class="text-primary font-semibold tracking-wider uppercase text-sm">@ViewModel.SectionLabel</h3>
                <span class="h-px w-8 bg-primary"></span>
            </div>
            <h2 class="text-4xl md:text-5xl font-display font-bold text-foreground mb-6">@ViewModel.Title <span class="text-gradient">@ViewModel.TitleHighlight</span></h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            @for (var i = 0; i < ViewModel.Services.Count; i++)
            {
                <div class="reveal" style="--reveal-delay: @(i * 70)ms;">
                    <ServiceCard Service="@ViewModel.Services[i]" Index="@(i + 1)" />
                </div>
            }
        </div>
    </div>
</section>
