@inject IJSRuntime JS

<div class="scroll-indicator-footer">
    <div class="scroll-indicator-container @(Variant == "dark" ? "scroll-indicator-dark" : "")" @onclick="ScrollToNext">
        <div class="scroll-mouse">
            <div class="scroll-wheel"></div>
        </div>
        <span class="scroll-text">@Text</span>
    </div>
</div>
