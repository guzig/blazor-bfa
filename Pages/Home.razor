@page "/"
@inject IJSRuntime JS

<PageTitle>BFA Consulting - Consulenza Energetica Smart City</PageTitle>

<Navbar />
<main>
    <Hero />
    <About />
    <Services />
    <Features />
    <Projects />
    <Testimonials />
    <Contact />
</main>
<Footer />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Trigger GSAP ScrollTrigger after Blazor renders the full page
            await JS.InvokeVoidAsync("blazorGsapBoot");
        }
    }
}
