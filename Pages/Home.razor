@page "/"
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>BFA Consulting – Consulenza Energetica</PageTitle>

<!-- ═══════════════════════════ NAVBAR ═══════════════════════════ -->
<header class="lp-nav @(scrolled ? "lp-nav--scrolled" : "")">
    <div class="lp-nav__inner">
        <a href="/" class="lp-nav__brand">BFA <span>Consulting</span></a>
        <nav class="lp-nav__links">
            <a href="#about">Chi Siamo</a>
            <a href="#services">Servizi</a>
            <a href="#why">Perché Noi</a>
            <a href="#testimonials">Clienti</a>
        </nav>
        <a href="#contact" class="lp-btn lp-btn--sm">Contattaci</a>
        <button class="lp-nav__burger" @onclick="ToggleMenu" aria-label="menu">
            <span></span><span></span><span></span>
        </button>
    </div>
    @if (menuOpen)
    {
        <nav class="lp-nav__mobile" @onclick="ToggleMenu">
            <a href="#about">Chi Siamo</a>
            <a href="#services">Servizi</a>
            <a href="#why">Perché Noi</a>
            <a href="#testimonials">Clienti</a>
            <a href="#contact" class="lp-btn lp-btn--sm" style="margin-top:.5rem;">Contattaci</a>
        </nav>
    }
</header>

<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
<section id="home" class="lp-hero">
    <video class="lp-hero__video" autoplay muted loop playsinline>
        <source src="videos/hero-video.mp4?v=3" type="video/mp4" />
    </video>
    <div class="lp-hero__overlay"></div>
    <div class="lp-container lp-hero__body">
        <div class="lp-hero__tag">BFA Consulting</div>
        <h1 class="lp-hero__title">
            Consulenza e servizi per la<br/>
            <span class="lp-hero__accent">gestione energetica</span>
        </h1>
        <p class="lp-hero__sub">
            Semplifichiamo la gestione delle forniture energetiche<br class="lp-hide-sm"/>
            massimizzando il risparmio per imprese e Pubblica Amministrazione.
        </p>
        <div class="lp-hero__ctas">
            <a href="#services" class="lp-btn lp-btn--primary">Scopri i Servizi</a>
            <a href="#contact" class="lp-btn lp-btn--ghost">Contattaci</a>
        </div>
    </div>
    <div class="lp-hero__stats">
        <div class="lp-container lp-hero__stats-row">
            <div class="lp-hero__stat"><strong>50+</strong><span>Comuni Serviti</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>2M €</strong><span>Risparmi Generati</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>1000+</strong><span>Fatture Controllate</span></div>
            <div class="lp-hero__stat-sep"></div>
            <div class="lp-hero__stat"><strong>99%</strong><span>Efficienza Energetica</span></div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ ABOUT ═══════════════════════════ -->
<section id="about" class="lp-section">
    <div class="lp-container lp-about">
        <div class="lp-about__media">
            <video autoplay muted loop playsinline class="lp-about__video">
                <source src="videos/about-bg.mp4?v=1" type="video/mp4" />
            </video>
            <div class="lp-about__media-badge">
                <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="currentColor"/></svg>
                Dal 2015
            </div>
        </div>
        <div class="lp-about__content">
            <div class="lp-label">Chi Siamo</div>
            <h2 class="lp-heading">
                Esperti al tuo fianco nella <span class="lp-accent">transizione energetica</span>
            </h2>
            <p class="lp-body">
                Fondata nel 2015, BFA Consulting è una società di consulenza energetica che affianca imprese e PA nella gestione strategica dell'energia. Uniamo competenza tecnica, software specialistico avanzato, e visione di lungo periodo per offrire soluzioni concrete di risparmio, efficienza e sostenibilità.
            </p>
            <p class="lp-body" style="margin-top:1rem;">
                Perché il cambiamento energetico non è solo una sfida — è un'opportunità.
            </p>
            <div class="lp-about__pills">
                <span class="lp-pill">✓ Controllo fatture</span>
                <span class="lp-pill">✓ Gestione energia</span>
                <span class="lp-pill">✓ Consulenza PA</span>
                <span class="lp-pill">✓ Sostenibilità</span>
            </div>
            <a href="#services" class="lp-btn lp-btn--primary" style="margin-top:2rem;">Scopri i Servizi →</a>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ SERVICES ═══════════════════════════ -->
<section id="services" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <div class="lp-label">I nostri servizi</div>
            <h2 class="lp-heading">Quali servizi <span class="lp-accent">Offriamo</span></h2>
            <p class="lp-body lp-section-header__sub">Soluzioni complete per ottimizzare la gestione energetica della tua organizzazione.</p>
        </div>
        <div class="lp-services-grid">
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#e0f2fe;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#0070a0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Controllo Fatture</h3>
                <p>Controllo correttezza contabile con certificazione di conformità alla normativa ARERA.</p>
                <ul>
                    <li>Acquisizione digitale completa della fattura</li>
                    <li>Certificazione di conformità con normativa ARERA</li>
                    <li>Gestione reclami per recupero errori</li>
                </ul>
            </div>
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#dcfce7;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Gestione Energia</h3>
                <p>Gestione completa delle forniture energetiche per ottimizzare costi e consumi.</p>
                <ul>
                    <li>Monitoraggio consumi in tempo reale</li>
                    <li>Reportistica personalizzata</li>
                    <li>Consulenza strategica energetica</li>
                </ul>
            </div>
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#fef3c7;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="#d97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>PEG Energetico</h3>
                <p>Piano di Efficientamento Energetico per ridurre i consumi e le emissioni.</p>
                <ul>
                    <li>Analisi energetica dettagliata</li>
                    <li>Proposte di intervento mirate</li>
                    <li>Monitoraggio risultati ottenuti</li>
                </ul>
            </div>
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#fce7f3;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" stroke="#db2777" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Contenzioso</h3>
                <p>Supporto nella gestione delle controversie con i fornitori di energia.</p>
                <ul>
                    <li>Analisi fatture contestate</li>
                    <li>Negoziazione con fornitori</li>
                    <li>Recupero crediti energia</li>
                </ul>
            </div>
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#ede9fe;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Risparmio Energetico</h3>
                <p>Strategie mirate per ridurre i costi energetici senza compromessi.</p>
                <ul>
                    <li>Analisi mercato energetico</li>
                    <li>Negoziazione tariffe vantaggiose</li>
                    <li>Ottimizzazione contratti fornitura</li>
                </ul>
            </div>
            <div class="lp-service-card">
                <div class="lp-service-card__icon" style="background:#d1fae5;">
                    <svg width="24" height="24" fill="none" viewBox="0 0 24 24"><path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h3>Consulenza Sostenibilità</h3>
                <p>Accompagniamo le aziende verso un futuro più sostenibile e green.</p>
                <ul>
                    <li>Certificazioni ambientali</li>
                    <li>Energie rinnovabili</li>
                    <li>Carbon footprint reduction</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ HOW IT WORKS ═══════════════════════════ -->
<section id="why" class="lp-section">
    <div class="lp-container">
        <div class="lp-section-header">
            <div class="lp-label">Perché Sceglierci</div>
            <h2 class="lp-heading">Come <span class="lp-accent">Lavoriamo</span></h2>
            <p class="lp-body lp-section-header__sub">Un processo collaudato in 4 fasi per garantire risultati misurabili.</p>
        </div>
        <div class="lp-steps">
            <div class="lp-step">
                <div class="lp-step__num">01</div>
                <div class="lp-step__content">
                    <h3>Analisi</h3>
                    <p>Raccogliamo e analizziamo tutte le forniture energetiche della tua organizzazione per identificare sprechi e anomalie.</p>
                </div>
            </div>
            <div class="lp-step__connector"></div>
            <div class="lp-step">
                <div class="lp-step__num">02</div>
                <div class="lp-step__content">
                    <h3>Pianificazione</h3>
                    <p>Elaboriamo un piano personalizzato di efficientamento energetico con obiettivi chiari e tempi definiti.</p>
                </div>
            </div>
            <div class="lp-step__connector"></div>
            <div class="lp-step">
                <div class="lp-step__num">03</div>
                <div class="lp-step__content">
                    <h3>Azione</h3>
                    <p>Implementiamo le soluzioni: controllo fatture, negoziazione tariffe, gestione contenzioso e monitoraggio continuo.</p>
                </div>
            </div>
            <div class="lp-step__connector"></div>
            <div class="lp-step">
                <div class="lp-step__num">04</div>
                <div class="lp-step__content">
                    <h3>Risultati</h3>
                    <p>Misuriamo e rendicontiamo i risparmi ottenuti con report dettagliati e trasparenti.</p>
                </div>
            </div>
        </div>

        <!-- Feature highlights -->
        <div class="lp-features-grid">
            <div class="lp-feature">
                <div class="lp-feature__icon" style="color:#0070a0;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="2"/></svg>
                </div>
                <h4>Piattaforma Unificata</h4>
                <p>Tutti i servizi integrati in un'unica dashboard intuitiva e potente.</p>
            </div>
            <div class="lp-feature">
                <div class="lp-feature__icon" style="color:#059669;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h4>Analisi Intelligente</h4>
                <p>Algoritmi avanzati per predizione, ottimizzazione e automazione.</p>
            </div>
            <div class="lp-feature">
                <div class="lp-feature__icon" style="color:#7c3aed;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h4>Sicurezza Garantita</h4>
                <p>Protezione dati conforme GDPR e massima riservatezza delle informazioni.</p>
            </div>
            <div class="lp-feature">
                <div class="lp-feature__icon" style="color:#d97706;">
                    <svg width="28" height="28" fill="none" viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="16 7 22 7 22 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <h4>Risultati Misurabili</h4>
                <p>Monitoraggio costante con report dettagliati sui risparmi ottenuti.</p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ TESTIMONIALS ═══════════════════════════ -->
<section id="testimonials" class="lp-section lp-section--alt">
    <div class="lp-container">
        <div class="lp-section-header">
            <div class="lp-label">I nostri clienti</div>
            <h2 class="lp-heading">Cosa dicono di <span class="lp-accent">noi</span></h2>
        </div>
        <div class="lp-testimonials">
            <div class="lp-testimonial">
                <div class="lp-testimonial__stars">★★★★★</div>
                <p class="lp-testimonial__text">"Personale qualificato e sempre disponibile. Ci hanno facilitato la fuoriuscita dal regime di salvaguardia in tempi brevissimi, con grande risparmio per l'Ente."</p>
                <div class="lp-testimonial__author">
                    <div class="lp-testimonial__avatar">OA</div>
                    <div>
                        <strong>Ing. Otranto Antonio</strong>
                        <span>Direttore Tecnico</span>
                    </div>
                </div>
            </div>
            <div class="lp-testimonial lp-testimonial--featured">
                <div class="lp-testimonial__stars">★★★★★</div>
                <p class="lp-testimonial__text">"Ci hanno supportato operativamente, anche presso i nostri uffici, facilitando sia la gestione corrente che il superamento del contenzioso pregresso. Abbiamo contestato numerose fatture non conformi, ottenendo un risparmio molto superiore al costo dei loro servizi."</p>
                <div class="lp-testimonial__author">
                    <div class="lp-testimonial__avatar">AM</div>
                    <div>
                        <strong>Arch. Aprigliano Marilena</strong>
                        <span>Direttore Tecnico</span>
                    </div>
                </div>
            </div>
            <div class="lp-testimonial">
                <div class="lp-testimonial__stars">★★★★☆</div>
                <p class="lp-testimonial__text">"Una squadra giovane, efficiente e dinamica sempre al nostro fianco. Ci supportano in tutte le fasi della gestione energetica comunale. Il risparmio è stato superiore al costo del loro servizio."</p>
                <div class="lp-testimonial__author">
                    <div class="lp-testimonial__avatar">BA</div>
                    <div>
                        <strong>Dott. Bernava Antonino</strong>
                        <span>Direttore Tecnico</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ CONTACT ═══════════════════════════ -->
<section id="contact" class="lp-section lp-section--dark">
    <div class="lp-container lp-contact">
        <div class="lp-contact__info">
            <div class="lp-label lp-label--light">Contattaci</div>
            <h2 class="lp-heading" style="color:#fff;">Pronto a <span style="color:#00a8e8;">risparmiare</span><br/>sulla tua energia?</h2>
            <p class="lp-body" style="color:rgba(255,255,255,.7); margin-top:1.25rem;">
                Parla con un nostro esperto senza impegno. Analizziamo la tua situazione e ti proponiamo soluzioni concrete.
            </p>
            <div class="lp-contact__details">
                <div class="lp-contact__detail">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <a href="tel:+390962123456">+39 0962 123456</a>
                </div>
                <div class="lp-contact__detail">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <a href="mailto:info@bfaconsulting.it">info@bfaconsulting.it</a>
                </div>
                <div class="lp-contact__detail">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>Via Crotone 59 – Isola di Capo Rizzuto (KR)</span>
                </div>
                <div class="lp-contact__detail">
                    <svg width="20" height="20" fill="none" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>Lun–Ven 9:00–18:00</span>
                </div>
            </div>
        </div>
        <form class="lp-contact__form" @onsubmit:preventDefault @onsubmit="HandleSubmit">
            @if (submitted)
            {
                <div class="lp-contact__success">
                    <svg width="40" height="40" fill="none" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <h3>Messaggio inviato!</h3>
                    <p>Ti risponderemo entro 24 ore.</p>
                </div>
            }
            else
            {
                <h3 class="lp-contact__form-title">Invia un messaggio</h3>
                <div class="lp-form-row">
                    <div class="lp-form-group">
                        <label>Nome e Cognome</label>
                        <input type="text" @bind="formName" placeholder="Mario Rossi" required />
                    </div>
                    <div class="lp-form-group">
                        <label>Email</label>
                        <input type="email" @bind="formEmail" placeholder="mario@comune.it" required />
                    </div>
                </div>
                <div class="lp-form-group">
                    <label>Organizzazione</label>
                    <input type="text" @bind="formOrg" placeholder="Comune di..." />
                </div>
                <div class="lp-form-group">
                    <label>Messaggio</label>
                    <textarea @bind="formMessage" rows="4" placeholder="Descrivi la tua esigenza energetica..." required></textarea>
                </div>
                <button type="submit" class="lp-btn lp-btn--primary" style="width:100%;">
                    Invia messaggio →
                </button>
            }
        </form>
    </div>
</section>

