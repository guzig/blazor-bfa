<!-- ═══════════════════════════ STYLES ═══════════════════════════ -->
<style>
/* ── Google Font ── */
@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ── Reset ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

/* ── Tokens ── */
:root {
    --blue:       #0070a0;
    --blue-dark:  #005580;
    --blue-light: #00a8e8;
    --green:      #059669;
    --ink:        #0f172a;
    --ink-muted:  #475569;
    --ink-light:  #94a3b8;
    --surface:    #ffffff;
    --surface-2:  #f8fafc;
    --border:     #e2e8f0;
    --radius:     12px;
    --radius-lg:  20px;
    --shadow:     0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
    --shadow-lg:  0 10px 40px rgba(0,0,0,.12);
    --font:       'Inter', 'Plus Jakarta Sans', -apple-system, sans-serif;
}

body { font-family: var(--font); color: var(--ink); background: var(--surface); -webkit-font-smoothing: antialiased; }

/* ── Utility ── */
.lp-container { max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; }
.lp-accent    { color: var(--blue-light); }
.lp-label     { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--blue); margin-bottom: .75rem; }
.lp-label--light { color: #7dd3fc; }
.lp-heading   { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.15; color: var(--ink); }
.lp-body      { font-size: 1rem; color: var(--ink-muted); line-height: 1.75; }
.lp-hide-sm   { display: block; }

/* ── Buttons ── */
.lp-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .875rem 2rem; border-radius: 9999px;
    font-weight: 700; font-size: .925rem; text-decoration: none; cursor: pointer;
    transition: transform .15s, box-shadow .15s, background .15s;
    border: none;
}
.lp-btn--primary {
    background: var(--blue); color: #fff;
    box-shadow: 0 4px 14px rgba(0,112,160,.35);
}
.lp-btn--primary:hover { background: var(--blue-dark); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,112,160,.45); }
.lp-btn--ghost {
    background: rgba(255,255,255,.1); color: #fff;
    border: 2px solid rgba(255,255,255,.4);
}
.lp-btn--ghost:hover { background: rgba(255,255,255,.2); transform: translateY(-2px); }
.lp-btn--sm { padding: .6rem 1.25rem; font-size: .875rem; }

/* ── Sections ── */
.lp-section        { padding: 6rem 0; background: var(--surface); }
.lp-section--alt   { background: var(--surface-2); }
.lp-section--dark  { background: var(--ink); }
.lp-section-header { text-align: center; max-width: 640px; margin: 0 auto 4rem; }
.lp-section-header__sub { margin-top: 1rem; }

/* ── NAVBAR ── */
.lp-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 1.25rem 0;
    transition: background .3s, backdrop-filter .3s, box-shadow .3s;
}
.lp-nav--scrolled {
    background: rgba(255,255,255,.95);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--border);
    padding: .875rem 0;
}
.lp-nav--scrolled .lp-nav__links a { color: var(--ink); }
.lp-nav--scrolled .lp-nav__links a:hover { color: var(--blue); }
.lp-nav--scrolled .lp-nav__brand { color: var(--ink) !important; }
.lp-nav--scrolled .lp-nav__brand span { color: var(--blue) !important; }
.lp-nav__inner {
    max-width: 1160px; margin: 0 auto; padding: 0 1.5rem;
    display: flex; align-items: center; gap: 2rem;
}
.lp-nav__brand {
    font-size: 1.3rem; font-weight: 800; text-decoration: none;
    color: #fff; letter-spacing: -.02em; flex-shrink: 0;
}
.lp-nav__brand span { color: #7dd3fc; }
.lp-nav__links { display: flex; gap: 2rem; margin-left: auto; }
.lp-nav__links a { text-decoration: none; color: rgba(255,255,255,.85); font-weight: 500; font-size: .925rem; transition: color .15s; }
.lp-nav__links a:hover { color: #fff; }
.lp-nav__burger {
    display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: .5rem; margin-left: auto;
}
.lp-nav__burger span { display: block; width: 22px; height: 2px; background: #fff; border-radius: 2px; transition: background .15s; }
.lp-nav--scrolled .lp-nav__burger span { background: var(--ink); }
.lp-nav__mobile {
    display: flex; flex-direction: column; gap: .5rem; padding: 1rem 1.5rem 1.5rem;
    background: #fff; border-top: 1px solid var(--border);
}
.lp-nav__mobile a { text-decoration: none; color: var(--ink); font-weight: 600; padding: .75rem 0; border-bottom: 1px solid var(--border); }

/* ── HERO ── */
.lp-hero {
    position: relative; min-height: 100vh;
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
}
.lp-hero__video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0;
}
.lp-hero__overlay {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(135deg, rgba(5,15,35,.85) 0%, rgba(0,80,130,.75) 60%, rgba(0,80,60,.6) 100%);
}
.lp-hero__body {
    position: relative; z-index: 2;
    padding-top: 7rem; padding-bottom: 3rem;
}
.lp-hero__tag {
    display: inline-block;
    background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2);
    color: #7dd3fc; font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    padding: .4rem 1rem; border-radius: 9999px; margin-bottom: 1.75rem;
    backdrop-filter: blur(8px);
}
.lp-hero__title {
    font-size: clamp(2.25rem, 6vw, 4.5rem); font-weight: 900; line-height: 1.1;
    color: #fff; margin-bottom: 1.5rem; letter-spacing: -.02em;
    font-family: var(--font);
}
.lp-hero__accent { color: #38bdf8; }
.lp-hero__sub {
    font-size: clamp(1rem, 2vw, 1.2rem); color: rgba(255,255,255,.8);
    max-width: 580px; line-height: 1.7; margin-bottom: 2.5rem;
}
.lp-hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; }

/* Stats bar */
.lp-hero__stats {
    position: relative; z-index: 2;
    background: rgba(255,255,255,.06); border-top: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(12px); margin-top: auto;
}
.lp-hero__stats-row {
    display: flex; align-items: center; justify-content: center;
    padding: 1.75rem 1.5rem; gap: 0; flex-wrap: wrap;
}
.lp-hero__stat { text-align: center; padding: .5rem 2.5rem; }
.lp-hero__stat strong { display: block; font-size: 1.75rem; font-weight: 800; color: #fff; line-height: 1; }
.lp-hero__stat span  { display: block; font-size: .8rem; color: rgba(255,255,255,.6); margin-top: .35rem; font-weight: 500; }
.lp-hero__stat-sep { width: 1px; height: 40px; background: rgba(255,255,255,.15); flex-shrink: 0; }

/* ── ABOUT ── */
.lp-about {
    display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;
}
.lp-about__media { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 4/3; }
.lp-about__video { width: 100%; height: 100%; object-fit: cover; }
.lp-about__media-badge {
    position: absolute; bottom: 1.5rem; left: 1.5rem;
    background: #fff; border-radius: 9999px; padding: .5rem 1.25rem;
    font-size: .875rem; font-weight: 700; color: var(--blue);
    box-shadow: var(--shadow); display: flex; align-items: center; gap: .5rem;
}
.lp-about__media-badge svg { color: #f59e0b; }
.lp-about__pills { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
.lp-pill {
    background: #eff6ff; color: var(--blue); border: 1px solid #bfdbfe;
    border-radius: 9999px; padding: .35rem .9rem; font-size: .85rem; font-weight: 600;
}

/* ── SERVICES GRID ── */
.lp-services-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
}
.lp-service-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 2rem;
    transition: box-shadow .2s, transform .2s;
}
.lp-service-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.lp-service-card__icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 1.25rem;
}
.lp-service-card h3 { font-size: 1.1rem; font-weight: 700; color: var(--ink); margin-bottom: .6rem; font-family: var(--font); }
.lp-service-card p  { font-size: .9rem; color: var(--ink-muted); line-height: 1.6; margin-bottom: 1rem; }
.lp-service-card ul { padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: .4rem; }
.lp-service-card ul li { font-size: .85rem; color: var(--ink-muted); padding-left: 1.1rem; position: relative; }
.lp-service-card ul li::before { content: '→'; position: absolute; left: 0; color: var(--blue-light); font-weight: 700; }

/* ── STEPS ── */
.lp-steps {
    display: flex; align-items: flex-start; gap: 0;
    margin-bottom: 5rem; overflow: hidden;
}
.lp-step { flex: 1; }
.lp-step__connector {
    flex-shrink: 0; width: 3rem; margin-top: 1.4rem;
    border-top: 2px dashed var(--border);
}
.lp-step__num {
    font-size: 2.5rem; font-weight: 900; color: #e0f2fe;
    line-height: 1; margin-bottom: .75rem;
    font-variant-numeric: tabular-nums;
    -webkit-text-stroke: 2px var(--blue);
    color: transparent;
}
.lp-step__content h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: .5rem; font-family: var(--font); }
.lp-step__content p  { font-size: .9rem; color: var(--ink-muted); line-height: 1.65; }

/* Feature highlights */
.lp-features-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;
    padding-top: 4rem; border-top: 1px solid var(--border);
}
.lp-feature__icon { margin-bottom: 1rem; }
.lp-feature h4 { font-size: 1rem; font-weight: 700; margin-bottom: .5rem; font-family: var(--font); }
.lp-feature p  { font-size: .875rem; color: var(--ink-muted); line-height: 1.65; }

/* ── TESTIMONIALS ── */
.lp-testimonials {
    display: grid; grid-template-columns: 1fr 1.15fr 1fr; gap: 1.5rem; align-items: start;
}
.lp-testimonial {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 2rem;
    box-shadow: var(--shadow);
}
.lp-testimonial--featured {
    background: var(--blue); border-color: var(--blue);
    box-shadow: 0 8px 32px rgba(0,112,160,.35);
}
.lp-testimonial--featured p,
.lp-testimonial--featured strong,
.lp-testimonial--featured span { color: #fff !important; }
.lp-testimonial--featured .lp-testimonial__text { color: rgba(255,255,255,.9) !important; }
.lp-testimonial--featured .lp-testimonial__stars { color: #fbbf24; }
.lp-testimonial__stars { font-size: 1rem; color: #f59e0b; margin-bottom: 1rem; letter-spacing: .05em; }
.lp-testimonial__text { font-size: .9rem; color: var(--ink-muted); line-height: 1.7; margin-bottom: 1.5rem; font-style: italic; }
.lp-testimonial__author { display: flex; align-items: center; gap: .75rem; }
.lp-testimonial__avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--blue-light); color: #fff;
    font-weight: 700; font-size: .875rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.lp-testimonial--featured .lp-testimonial__avatar { background: rgba(255,255,255,.2); }
.lp-testimonial__author strong { display: block; font-size: .9rem; color: var(--ink); }
.lp-testimonial__author span   { font-size: .8rem; color: var(--ink-muted); }

/* ── CONTACT ── */
.lp-contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: start; }
.lp-contact__details { margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
.lp-contact__detail {
    display: flex; align-items: center; gap: .875rem;
    color: rgba(255,255,255,.75); font-size: .95rem;
}
.lp-contact__detail svg { flex-shrink: 0; color: #7dd3fc; }
.lp-contact__detail a { color: rgba(255,255,255,.85); text-decoration: none; transition: color .15s; }
.lp-contact__detail a:hover { color: #fff; }
.lp-contact__form {
    background: #fff; border-radius: var(--radius-lg); padding: 2.5rem;
    box-shadow: 0 20px 60px rgba(0,0,0,.25);
}
.lp-contact__form-title { font-size: 1.35rem; font-weight: 700; color: var(--ink); margin-bottom: 1.75rem; font-family: var(--font); }
.lp-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.lp-form-group { display: flex; flex-direction: column; gap: .4rem; margin-bottom: 1.1rem; }
.lp-form-group label { font-size: .85rem; font-weight: 600; color: var(--ink-muted); }
.lp-form-group input,
.lp-form-group textarea {
    padding: .75rem 1rem; border: 1.5px solid var(--border); border-radius: var(--radius);
    font-size: .95rem; font-family: var(--font); color: var(--ink);
    transition: border-color .15s, box-shadow .15s; outline: none;
    background: var(--surface);
}
.lp-form-group input:focus,
.lp-form-group textarea:focus {
    border-color: var(--blue); box-shadow: 0 0 0 3px rgba(0,112,160,.12);
}
.lp-form-group textarea { resize: vertical; min-height: 100px; }
.lp-contact__success {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: 300px; text-align: center; gap: 1rem; color: var(--ink);
}
.lp-contact__success h3 { font-size: 1.5rem; font-weight: 700; font-family: var(--font); }
.lp-contact__success p  { color: var(--ink-muted); }

/* ── FOOTER ── */
.lp-footer { background: #060f1e; padding: 5rem 0 0; }
.lp-footer__inner {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 3rem;
    padding-bottom: 4rem; border-bottom: 1px solid rgba(255,255,255,.08);
}
.lp-footer__brand p { color: rgba(255,255,255,.45); font-size: .9rem; margin-top: .75rem; line-height: 1.65; }
.lp-footer__links { display: flex; flex-direction: column; gap: .75rem; }
.lp-footer__links strong { color: #fff; font-size: .875rem; margin-bottom: .25rem; }
.lp-footer__links a, .lp-footer__links span { color: rgba(255,255,255,.45); font-size: .875rem; text-decoration: none; transition: color .15s; }
.lp-footer__links a:hover { color: #fff; }
.lp-footer__bottom { padding: 1.5rem 0; text-align: center; color: rgba(255,255,255,.3); font-size: .825rem; }

/* ── RESPONSIVE ── */
@@media (max-width: 1024px) {
    .lp-services-grid   { grid-template-columns: repeat(2, 1fr); }
    .lp-features-grid   { grid-template-columns: repeat(2, 1fr); }
    .lp-footer__inner   { grid-template-columns: 1fr 1fr; }
}

@@media (max-width: 768px) {
    .lp-section { padding: 4rem 0; }
    .lp-nav__links { display: none; }
    .lp-nav .lp-btn--sm { display: none; }
    .lp-nav__burger { display: flex; }
    .lp-about { grid-template-columns: 1fr; gap: 2.5rem; }
    .lp-services-grid { grid-template-columns: 1fr; }
    .lp-steps { flex-direction: column; gap: 2rem; }
    .lp-step__connector { width: 2px; height: 2rem; border-top: none; border-left: 2px dashed var(--border); margin: 0 0 0 1.1rem; }
    .lp-features-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .lp-testimonials { grid-template-columns: 1fr; }
    .lp-contact { grid-template-columns: 1fr; gap: 3rem; }
    .lp-form-row { grid-template-columns: 1fr; }
    .lp-footer__inner { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .lp-hero__stat-sep { display: none; }
    .lp-hero__stats-row { gap: 1rem; }
    .lp-hero__stat { padding: .5rem 1rem; }
    .lp-hide-sm { display: none; }
}

@@media (max-width: 480px) {
    .lp-features-grid { grid-template-columns: 1fr; }
    .lp-footer__inner { grid-template-columns: 1fr; }
    .lp-contact__form { padding: 1.5rem; }
    .lp-hero__ctas { flex-direction: column; }
    .lp-hero__ctas .lp-btn { width: 100%; justify-content: center; }
}
</style>

@code {
    bool scrolled  = false;
    bool menuOpen  = false;
    bool submitted = false;

    string formName    = "";
    string formEmail   = "";
    string formOrg     = "";
    string formMessage = "";

    void ToggleMenu() => menuOpen = !menuOpen;

    void HandleSubmit()
    {
        submitted = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
                window.addEventListener('scroll', function() {
                    var header = document.querySelector('.lp-nav');
                    if (header) {
                        if (window.scrollY > 40) header.classList.add('lp-nav--scrolled');
                        else header.classList.remove('lp-nav--scrolled');
                    }
                });
            ");
        }
    }
}
